<% content_for :title, "Feedback sent" %>
<% back_path = @feedback.page.presence || root_path %>
<%= render "shared/page_header", title: "Feedback sent", back: back_path %>

<div class="flex flex-col items-center text-center gap-3 pt-10" data-controller="feedback-draft" data-feedback-draft-clear-value="true">
  <h2 class="font-heading text-record">Thank you</h2>
  <p class="max-w-72">We read every message. We can't reply to each one, but it helps us fix and improve Groupifico.</p>
  <%= link_to back_path, class: "btn btn-primary mt-2" do %><%= icon :return, class: "size-icon-control" %>Back to where you were<% end %>
</div>
