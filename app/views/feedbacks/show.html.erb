<% content_for :title, "Feedback sent" %>
<% content_for :shell_controller, @feedback.page_controller if @group %>
<%= render "shared/page_header", title: "Feedback sent", back: @back_path %>

<%= tag.div class: "flex flex-col items-center text-center gap-3 pt-10", data: { controller: "feedback-draft", feedback_draft_key_value: "feedback-draft-#{Current.user.id}", feedback_draft_clear_value: true } do %>
  <h2 class="font-heading text-record">Thank you</h2>
  <p class="max-w-72">We read every message. We can't reply to each one, but it helps us fix and improve <%= Current.brand.name %>.</p>
  <%= link_to @back_path, class: "btn btn-primary mt-2" do %><%= icon :return, class: "size-icon-control" %>Back to where you were<% end %>
<% end %>
