<%= form_with(model: user_profile, class: "contents") do |form| %>
  <% fields = capture do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Profile details</legend>

      <%= form.field :first_name %>
      <%= form.field :last_name %>
      <%= form.field :mobile_phone, as: :telephone_field %>
    </fieldset>
  <% end %>

  <%= render "shared/errors", form: form %>
  <%= fields %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
