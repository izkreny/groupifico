<% content_for :title, "Styleguide" %>
<%# WHY: a switch redirects back here, which Turbo takes as a refresh, so the page morphs in place rather than reloading at the top; `section-anchor` below then keeps the section that was in view where it was. %>
<% turbo_refreshes_with method: :morph, scroll: :preserve %>

<%#
  Each registration comes from its event's loaded `registrations`, because nobody acts on this page, so no pick goes through a member.

  The two forms draw events not yet saved, so theirs are built here rather than read.
%>
<%
  soon = 2.days.from_now.change(hour: 19)

  question = @next_up.registrations.find(&:invited?)
  answer   = @next_up.registrations.find(&:yes?)

  rows = [
    [ @unconfirmed, @unconfirmed.registrations.find(&:invited?) ],
    [ @ongoing,     @ongoing.registrations.find(&:yes?) ],
    [ @concluded,   nil ],
    [ @canceled,    nil ]
  ]

  unsaved = Event.new(group: @group, name: "Autumn concert", starts_at: soon, ends_at: soon + 2.hours)
  unsaved.build_address
  invalid = Event.new(group: @group, name: "Autumn concert")
  invalid.errors.add(:starts_at, :blank)
  invalid.errors.add(:creator, :required)

  newcomer = Member.new(group: @group)
  # The member rows ask what `members#index` asks, of a member not yet in the list.
  manages  = allowed_to?(:edit?, newcomer)
  oversees = allowed_to?(:oversee?, newcomer)
%>

<div class="flex flex-col gap-8" data-controller="section-anchor" data-action="turbo:submit-start@document->section-anchor#remember turbo:morph@document->section-anchor#restore">
  <%# WHY: sticky inside the page's one column rather than fixed, so it keeps the column's width and takes the root theme rather than either twin's. %>
  <header id="member_switcher" class="sticky top-0 z-10 bg-base-100 border-b border-base-300 py-2 text-sm">
    <%= form_with url: styleguide_session_path, class: "flex flex-wrap items-center gap-2", data: { controller: "form" } do |form| %>
      <%= form.label :member_id, "Signed in as", class: "label" %>
      <%# WHY: the prompt shows only while the signed-in user is no member here, so it names them rather than asking for a pick. %>
      <%= form.select :member_id, member_switch_choices(@members), { selected: @members.find { it.user_id == Current.user.id }&.id, prompt: "#{Current.user.profile.full_name} (not a member)" }, class: "select select-sm w-auto", required: true, data: { action: "change->form#submit" } %>
    <% end %>
  </header>

  <div>
    <h1 class="text-hero">Styleguide</h1>
    <p class="text-meta">Every colour, type size, component and partial, drawn from sample records under the light and the dark theme.</p>
  </div>

  <%= render layout: "styleguides/section", locals: { title: "Colour tokens", stacked: true } do |theme| %>
    <%= render "styleguides/foundations/colour_tokens", theme: %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Type ladder" } do %>
    <%= render "styleguides/foundations/type_ladder" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Character set" } do %>
    <%= render "styleguides/foundations/character_set" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Alert", docs: "https://daisyui.com/components/alert/" } do %>
    <%= render "styleguides/components/alert", original: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Badge", docs: "https://daisyui.com/components/badge/" } do %>
    <%= render "styleguides/components/badge" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Button", docs: "https://daisyui.com/components/button/" } do %>
    <%= render "styleguides/components/button" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Card", docs: "https://daisyui.com/components/card/" } do %>
    <%= render "styleguides/components/card" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Collapse", docs: "https://daisyui.com/components/collapse/" } do |theme| %>
    <%= render "styleguides/components/collapse", event: @next_up, theme: %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Input", docs: "https://daisyui.com/components/input/" } do |theme| %>
    <%= render "styleguides/components/input", theme: %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Select", docs: "https://daisyui.com/components/select/" } do |theme| %>
    <%= render "styleguides/components/select", theme:, group: @group %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Page header" } do %>
    <%= render "shared/page_header", title: "Event" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Flash, notice and alert" } do %>
    <%= render "layouts/flash" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Hero card" } do %>
    <%= render "events/next_up", event: @next_up, registration: question %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Record facts" } do %>
    <%= render "events/event", event: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Compact rows, one per event status" } do %>
    <%= render "styleguides/app_partials/event_rows", rows: %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Counts" } do %>
    <%= render "events/counts", event: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "RSVP, question and answer" } do %>
    <%= render "styleguides/app_partials/rsvps", event: @next_up, question:, answer: %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Roster" } do %>
    <%= render "events/roster", event: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Fields, with a hint and with an error" } do |theme| %>
    <%= render "styleguides/app_partials/fields", event: invalid, theme: %>
  <% end %>

  <%# WHY: each screen's own section is drawn only for a user that screen would let in, asked as its controller asks, so a switch to a member shows the page as they could reach it. %>
  <% if allowed_to?(:new?, unsaved) %>
    <%= render layout: "styleguides/section", locals: { title: "Event form" } do |theme| %>
      <%# Namespaced apart from the fields section's form too, which is an `Event` form under the same theme. %>
      <%= render "events/form", group: @group, event: unsaved, submit: "Create event", cancel: "#", namespace: "#{theme}_form" %>
    <% end %>
  <% end %>

  <% if allowed_to?(:destroy?, @next_up) %>
    <%= render layout: "styleguides/section", locals: { title: "Confirm sheet" } do |theme| %>
      <%= render "events/delete", group: @group, event: @next_up, id: "confirm_delete_#{theme}" %>
    <% end %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Header, with the group switcher and the tabs" } do |theme| %>
    <%= render "layouts/header_with_switcher",
          memberships: @memberships,
          brand_name: Current.brand.name,
          group: @group,
          group_name: @group.name,
          initials: @owner.initials,
          editable: allowed_to?(:edit?, @group),
          switcher_id: "group_switcher_#{theme}",
          tabs: true,
          section: :events %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Tabs in the dock" } do %>
    <%= render "layouts/dock", group: @group, section: :events, static: true %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Group cards, owner and paused" } do %>
    <%= render "styleguides/app_partials/group_cards", group: @group, owner: @owner, paused: @paused %>
  <% end %>

  <% if allowed_to?(:edit?, @group) %>
    <%= render layout: "styleguides/section", locals: { title: "Group form" } do |theme| %>
      <%= render "groups/form", group: @group, namespace: "#{theme}_group" %>
    <% end %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Address" } do %>
    <%= render "addresses/address", address: @group.address %>
  <% end %>

  <% if allowed_to?(:edit?, @group.address) %>
    <%= render layout: "styleguides/section", locals: { title: "Address form" } do |theme| %>
      <%= render "addresses/form", address: @group.address, namespace: "#{theme}_address" %>
    <% end %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Member rows, owner and paused" } do %>
    <%= render "styleguides/app_partials/member_rows", owner: @owner, paused: @paused, manages:, oversees: %>
  <% end %>

  <% if allowed_to?(:new?, newcomer) %>
    <%= render layout: "styleguides/section", locals: { title: "Member form" } do |theme| %>
      <%= render "members/form", group: @group, member: newcomer, submit: "Send invite", cancel: "#", namespace: "#{theme}_member" %>
    <% end %>
  <% end %>

  <%# WHY: the signed-in user's own profile, the one the Me screen lets anybody reach, rather than a sample's nobody else could open. %>
  <%= render layout: "styleguides/section", locals: { title: "Profile" } do %>
    <%= render "user_profiles/user_profile", user_profile: Current.user.profile %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Profile form" } do |theme| %>
    <%= render "user_profiles/form", user_profile: Current.user.profile, namespace: "#{theme}_profile" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Legend icons", source: [ "Heroicons", "https://heroicons.com" ] } do %>
    <%= render "styleguides/foundations/legend_icons" %>
  <% end %>
</div>
