<% content_for :title, "Styleguide" %>

<%#
  Each registration comes from its event's loaded `registrations`, because nobody acts on this page, so no pick goes through a member.

  The two forms draw events not yet saved, so theirs are built here rather than read.
%>
<%
  soon = 2.days.from_now.change(hour: 19)

  question = @next_up.registrations.find(&:invited?)
  answer   = @next_up.registrations.find(&:yes?)

  rows = [
    [ @unconfirmed, @unconfirmed.registrations.find(&:invited?) ],
    [ @ongoing,     @ongoing.registrations.find(&:yes?) ],
    [ @concluded,   nil ],
    [ @canceled,    nil ]
  ]

  unsaved = Event.new(group: @group, name: "Autumn concert", starts_at: soon, ends_at: soon + 2.hours)
  unsaved.build_address
  invalid = Event.new(group: @group, name: "Autumn concert")
  invalid.errors.add(:starts_at, :blank)
  invalid.errors.add(:creator, :required)

  newcomer = Member.new(group: @group)
%>

<div class="flex flex-col gap-8">
  <div>
    <h1 class="text-hero">Styleguide</h1>
    <p class="text-meta">Every colour, type size, component and partial, drawn from sample records under the light and the dark theme.</p>
  </div>

  <%= render layout: "styleguides/section", locals: { title: "Colour tokens", stacked: true } do |theme| %>
    <%= render "styleguides/colour_tokens", theme: %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Type ladder" } do %>
    <%= render "styleguides/type_ladder" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Page header" } do %>
    <%= render "shared/page_header", title: "Event" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Flash, notice and alert" } do %>
    <%= render "layouts/flash" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Hero card" } do %>
    <%= render "events/next_up", event: @next_up, registration: question %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Record facts" } do %>
    <%= render "events/event", event: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Compact rows, one per event status" } do %>
    <ul class="list">
      <% rows.each do |event, registration| %>
        <%= render "events/row", event: event, registration: registration %>
      <% end %>
    </ul>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Counts" } do %>
    <%= render "events/counts", event: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "RSVP, question and answer" } do %>
    <div class="flex flex-col gap-4">
      <%= render "events/rsvp", event: @next_up, registration: question %>
      <%= render "events/rsvp", event: @next_up, registration: answer %>
    </div>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Roster" } do %>
    <%= render "events/roster", event: @next_up %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Fields, with a hint and with an error" } do |theme| %>
    <%= form_with model: invalid, url: styleguide_path, method: :get, namespace: theme do |form| %>
      <%= form.with_error_summary do %>
        <fieldset class="fieldset">
          <%= form.field :name, hint: "What the group calls it, as it appears on every list." %>
          <%= form.field :starts_at, as: :datetime_field %>
        </fieldset>
      <% end %>
    <% end %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Event form" } do |theme| %>
    <%# Namespaced apart from the fields section's form too, which is an `Event` form under the same theme. %>
    <%= render "events/form", group: @group, event: unsaved, submit: "Create event", cancel: "#", namespace: "#{theme}_form" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Confirm sheet" } do |theme| %>
    <%= render "events/delete", group: @group, event: @next_up, id: "confirm_delete_#{theme}" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Header, with the group switcher and the tabs" } do |theme| %>
    <%= tag.div data: { controller: "group-switcher" } do %>
      <%= render "layouts/header",
            brand_name: Current.brand.name,
            group: @group,
            group_name: @group.name,
            initials: @owner.initials,
            editable: true,
            switcher_id: "group_switcher_#{theme}",
            tabs: true,
            section: :events %>
      <%= render "layouts/group_switcher", id: "group_switcher_#{theme}", memberships: @memberships, current_group: @group %>
    <% end %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Tabs in the dock" } do %>
    <%# WHY: `static`, because the dock is fixed to the viewport's foot on a screen and would leave its twin here. %>
    <nav class="dock static" aria-label="Group sections">
      <%= render "layouts/group_tabs", group: @group, section: :events, in_dock: true %>
    </nav>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Group cards, owner and paused" } do %>
    <div class="flex flex-col gap-2">
      <%= render "groups/group", group: @group, membership: @owner %>
      <%= render "groups/group", group: @group, membership: @paused %>
    </div>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Group form" } do |theme| %>
    <%= render "groups/form", group: @group, namespace: "#{theme}_group" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Address" } do %>
    <%= render "addresses/address", address: @group.address %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Address form" } do |theme| %>
    <%= render "addresses/form", address: @group.address, namespace: "#{theme}_address" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Member rows, owner and paused" } do %>
    <ul class="list">
      <%= render "members/member", member: @owner, manages: true %>
      <%= render "members/member", member: @paused, manages: true %>
    </ul>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Member form" } do |theme| %>
    <%= render "members/form", group: @group, member: newcomer, submit: "Send invite", cancel: "#", namespace: "#{theme}_member" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Profile" } do %>
    <%= render "user_profiles/user_profile", user_profile: @owner.profile %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Profile form" } do |theme| %>
    <%= render "user_profiles/form", user_profile: @owner.profile, namespace: "#{theme}_profile" %>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Components no partial draws, as their screens use them" } do |theme| %>
    <div class="flex flex-col gap-4">
      <div role="status" class="alert">
        <%= icon :duplicate, class: "size-6 shrink-0" %>
        <span>Copied from an earlier event. Dates moved on 7 days, status back to unconfirmed, nobody registered yet.</span>
      </div>

      <%= select_tag :scope,
            options_for_select([ [ "Upcoming events", "upcoming" ], [ "Past events", "past" ] ], "upcoming"),
            id: "scope_#{theme}",
            class: "select select-ghost bg-base-200 rounded-full",
            aria: { label: "Which events to show" } %>

      <div class="card card-sm bg-base-200">
        <div class="card-body">
          <details class="collapse collapse-arrow">
            <summary class="collapse-title flex flex-col gap-2 px-0">
              <span class="font-semibold">Who&rsquo;s coming</span>
              <%= render "events/counts", event: @next_up %>
            </summary>
          </details>
        </div>
      </div>

      <%= link_to new_group_path, class: "btn btn-primary btn-block" do %>
        <%= icon :new, class: "size-4" %>New group
      <% end %>
    </div>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Variants the app does not use yet" } do |theme| %>
    <div class="flex flex-col gap-4">
      <div class="flex flex-wrap items-center gap-2">
        <button type="button" class="btn btn-sm btn-secondary">Secondary</button>
        <button type="button" class="btn btn-sm btn-accent">Accent</button>
        <button type="button" class="btn btn-sm btn-neutral">Neutral</button>
        <button type="button" class="btn btn-sm btn-outline btn-primary">Outline</button>
        <button type="button" class="btn btn-sm btn-soft btn-primary">Soft</button>
        <button type="button" class="btn btn-sm btn-disabled" disabled>Disabled</button>
      </div>

      <div class="flex flex-wrap items-end gap-2">
        <fieldset class="fieldset">
          <label class="label" for="variant_role_<%= theme %>">Role</label>
          <select id="variant_role_<%= theme %>" class="select select-sm">
            <option>Member</option>
            <option>Organiser</option>
          </select>
        </fieldset>

        <fieldset class="fieldset">
          <label class="label" for="variant_email_<%= theme %>">Email</label>
          <input id="variant_email_<%= theme %>" type="email" autocomplete="off" placeholder="Invalid" class="input input-sm input-error">
        </fieldset>
      </div>

      <div class="flex flex-wrap items-center gap-2">
        <span class="badge badge-sm badge-primary">Primary</span>
        <span class="badge badge-sm badge-secondary">Secondary</span>
        <span class="badge badge-sm badge-accent">Accent</span>
        <span class="badge badge-sm badge-neutral">Neutral</span>
        <span class="badge badge-sm badge-soft badge-primary">Soft primary</span>
        <span class="badge badge-sm badge-outline badge-secondary">Outline secondary</span>
        <span class="badge badge-sm badge-info">Info</span>
        <span class="badge badge-sm badge-success">Success</span>
        <span class="badge badge-sm badge-warning">Warning</span>
        <span class="badge badge-sm badge-error">Error</span>
      </div>

      <div class="card card-sm card-border bg-base-100">
        <div class="card-body">
          <p class="card-title">Bordered card</p>
          <p>A card on base-100 with the border daisyUI derives from base-300.</p>
        </div>
      </div>

      <div role="alert" class="alert alert-info"><span>Info: your invitation was sent.</span></div>
      <div role="alert" class="alert alert-warning"><span>Warning: the event is nearly full.</span></div>
      <div role="alert" class="alert alert-soft alert-info"><span>Soft info</span></div>
      <div role="alert" class="alert alert-soft alert-success"><span>Soft success</span></div>
      <div role="alert" class="alert alert-soft alert-error"><span>Soft error</span></div>
    </div>
  <% end %>

  <%= render layout: "styleguides/section", locals: { title: "Legend icons" } do %>
    <%= render "styleguides/legend_icons" %>
  <% end %>
</div>
