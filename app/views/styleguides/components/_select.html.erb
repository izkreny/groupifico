<%# locals: (theme:) %>
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3 class="text-meta">As the app uses it</h3>

    <%= select_tag :scope,
          options_for_select([ [ "Upcoming events", "upcoming" ], [ "Past events", "past" ] ], "upcoming"),
          id: "select_scope_#{theme}",
          class: "select select-ghost bg-base-200 rounded-full",
          aria: { label: "Which events to show" } %>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Not used yet</h3>

    <fieldset class="fieldset">
      <label class="label" for="select_role_<%= theme %>">Role</label>
      <select id="select_role_<%= theme %>" class="select select-sm">
        <option>Member</option>
        <option>Organiser</option>
      </select>
    </fieldset>
  </div>
</div>
