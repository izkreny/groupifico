<%# locals: (theme:, group:) %>
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3 class="text-meta">As the app uses it</h3>

    <%= render "events/scope_select", group:, past: false, id: "select_scope_#{theme}" %>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Not used yet</h3>

    <fieldset class="fieldset">
      <label class="label" for="select_role_<%= theme %>">Role</label>
      <select id="select_role_<%= theme %>" class="select select-sm">
        <option>Member</option>
        <option>Organiser</option>
      </select>
    </fieldset>
  </div>
</div>
