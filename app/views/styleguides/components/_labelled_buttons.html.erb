<%# locals: () %>
<%# Every button the app draws with an icon and a label, in the classes its screen gives it, grouped by size, each with its icon at 20px, 8px from the label (the app stylesheet's one `.btn` gap). Inert copies: nothing here submits or navigates. %>
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Block, on the sign-in, sign-up and group screens</h3>
    <button type="button" class="btn btn-primary btn-block"><%= icon :confirm, class: "size-icon-control" %> Sign in</button>
    <button type="button" class="btn btn-primary btn-block"><%= icon :email, class: "size-icon-control" %> Email me a sign-in link</button>
    <button type="button" class="btn btn-primary btn-block"><%= icon :new, class: "size-icon-control" %>New group</button>
    <button type="button" class="btn btn-primary btn-block"><%= icon :invited, class: "size-icon-control" %><span>Invite</span></button>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Regular and small</h3>
    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="btn btn-primary"><%= icon :new, class: "size-icon-control" %>New event</button>
      <button type="button" class="btn"><%= icon :new, class: "size-icon-control" %>Create group</button>
      <button type="button" class="btn btn-primary btn-sm"><%= icon :new, class: "size-icon-control" %>New</button>
      <button type="button" class="btn btn-primary btn-sm"><%= icon :new, class: "size-icon-control" %>Invite</button>
      <button type="button" class="btn btn-sm"><%= icon :add_member, class: "size-icon-control" %>Add someone</button>
      <button type="button" class="btn btn-sm"><%= icon :invited, class: "size-icon-control" %>Invite the rest</button>
      <button type="button" class="btn btn-sm"><%= icon :invited, class: "size-icon-control" %>Invite everyone</button>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Yes · Maybe · No</h3>
    <div class="flex flex-wrap gap-2">
      <button type="button" class="btn btn-sm btn-success"><%= icon :yes, class: "size-icon-control" %>Yes</button>
      <button type="button" class="btn btn-sm btn-ghost"><%= icon :maybe, class: "size-icon-control text-warning" %>Maybe</button>
      <button type="button" class="btn btn-sm btn-ghost"><%= icon :no, class: "size-icon-control text-error" %>No</button>
    </div>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Link, with its icon after the label</h3>
    <button type="button" class="link link-hover inline-flex items-center gap-1 text-card-fact self-start">See all events<%= icon :go_to, class: "size-icon-inline" %></button>
  </div>
</div>
