<%# locals: (original:) %>
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3 class="text-meta">As the app uses it</h3>

    <%= render "events/duplicate_notice", original: %>
    <%= render layout: "shared/alert", locals: { kind: :success, dismissible: true } do %><span>Event was successfully updated.</span><% end %>
    <%= render layout: "shared/alert", locals: { kind: :error, dismissible: true } do %><span>You are not allowed to do that.</span><% end %>
    <%= render layout: "shared/alert", locals: { kind: :error } do %><span>Please fix the highlighted fields.</span><span>Name can't be blank</span><% end %>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Not used yet</h3>

    <%= render layout: "shared/alert", locals: { kind: :info, dismissible: true } do %><span>Info: your invitation was sent.</span><% end %>
    <%= render layout: "shared/alert", locals: { kind: :warning, dismissible: true } do %><span>Warning: the event is nearly full.</span><% end %>
  </div>
</div>
