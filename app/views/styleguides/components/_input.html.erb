<%# locals: (theme:) %>
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3 class="text-meta">As the app uses it</h3>

    <fieldset class="fieldset">
      <label class="label" for="input_name_<%= theme %>">Name</label>
      <input id="input_name_<%= theme %>" type="text" autocomplete="off" placeholder="Type here" class="input w-full">
    </fieldset>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Not used yet</h3>

    <fieldset class="fieldset">
      <label class="label" for="input_email_<%= theme %>">Email</label>
      <input id="input_email_<%= theme %>" type="email" autocomplete="off" placeholder="Invalid" class="input input-sm input-error">
    </fieldset>
  </div>
</div>
