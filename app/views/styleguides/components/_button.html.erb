<%# locals: () %>
<div class="flex flex-col gap-4">
  <div class="flex flex-col gap-2">
    <h3 class="text-meta">As the app uses it</h3>
    <p class="text-meta">An icon button is a <code>size-control</code> box around a <code>size-icon-control</code> glyph, and a strip of them stands <code>gap-controls</code> apart, which sets the glyphs 20px apart.</p>

    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="btn btn-primary"><%= icon :save, class: "size-icon-control" %>Save</button>
      <button type="button" class="btn"><%= icon :edit, class: "size-icon-control" %>Correct</button>
      <button type="button" class="btn btn-ghost"><%= icon :cancel, class: "size-icon-control" %>Cancel</button>
      <button type="button" class="btn btn-error"><%= icon :delete, class: "size-icon-control" %>Delete</button>
      <button type="button" class="btn btn-sm"><%= icon :invited, class: "size-icon-control" %>Invite the rest</button>
      <button type="button" class="btn btn-ghost btn-circle btn-sm text-primary" aria-label="Edit">
        <%= icon :edit, class: "size-icon-control" %>
      </button>
      <button type="button" class="btn btn-ghost btn-sm btn-square" aria-label="Email">
        <%= icon :email, class: "size-icon-control" %>
      </button>
    </div>

    <%= render "shared/block_button", url: new_group_path do %>
      <%= icon :new, class: "size-icon-control" %>New group
    <% end %>
  </div>

  <div class="flex flex-col gap-2">
    <h3 class="text-meta">Not used yet</h3>

    <div class="flex flex-wrap items-center gap-2">
      <button type="button" class="btn btn-sm btn-secondary">Secondary</button>
      <button type="button" class="btn btn-sm btn-accent">Accent</button>
      <button type="button" class="btn btn-sm btn-neutral">Neutral</button>
      <button type="button" class="btn btn-sm btn-outline btn-primary">Outline</button>
      <button type="button" class="btn btn-sm btn-soft btn-primary">Soft</button>
      <button type="button" class="btn btn-sm btn-disabled" disabled>Disabled</button>
    </div>
  </div>
</div>
