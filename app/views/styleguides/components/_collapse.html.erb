<%# locals: (theme:) %>
<div class="flex flex-col gap-2">
  <h3 class="text-meta">As the app uses it</h3>

  <div class="card card-sm bg-base-200">
    <div class="card-body gap-3">
      <%= render "events/roster_toggle", roster_id: "collapse_roster_#{theme}" %>

      <p id="collapse_roster_<%= theme %>" class="hidden peer-open:block">The roster unfolds here.</p>
    </div>
  </div>
</div>
