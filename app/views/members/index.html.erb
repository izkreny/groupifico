<% content_for :title, "Members" %>

<%#
  The group's roster. The shell's header already carries the group's name, so this tab draws no
  title of its own, as the events list draws none.

  Both capabilities are the reader's rather than a row's, so each is asked once, of a member with
  nothing on it but the group: a per-row `allowed_to?` builds a policy and looks up the reader's
  membership for every member. `create?` decides the count and Invite, a write a paused manager is
  refused. `edit?` decides the pencil, the inactive toggle and the "not signed in yet" mark, which
  are reads a paused manager keeps.
%>
<% unattached = Member.new(group: @group) %>
<% may_add = allowed_to?(:create?, unattached) %>
<% manages = allowed_to?(:edit?, unattached) %>

<div class="flex flex-col gap-3">
  <% if may_add %>
    <div class="flex items-center justify-between gap-2.5">
      <p><%= pluralize @group.current_members.count, "member" %></p>

      <%= link_to new_group_member_path(@group), class: "btn btn-primary btn-sm" do %>
        <%= icon :new, class: "size-4" %>Invite
      <% end %>
    </div>
  <% end %>

  <% if @members.any? %>
    <ul id="members" class="list">
      <%= render partial: "members/member", collection: @members, locals: { manages: } %>
    </ul>
  <% else %>
    <p>No members found.</p>
  <% end %>

  <% if manages %>
    <%= link_to (@inactive_shown ? "Hide inactive" : "Show inactive"),
          group_members_path(@group, inactive: (1 unless @inactive_shown)),
          class: "link link-hover self-start" %>
  <% end %>
</div>
