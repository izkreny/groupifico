<%# locals: (member:, manages:, oversees:) %>
<%#
  One roster row. A member who is not active is dimmed to the theme's `base-content` at 70%, which holds AA in both themes, and carries no status tag, since the open tab already names it. Call and Email are every reader's; Call only where the member has a mobile, since every member
  has an address and not every one a number. The detail is every reader's too, so the name links
  there, and only the pencil opens the edit form.

  The "not signed in yet" mark is the roster's alone, never the member screen's, and only for a member who oversees the list: they are the ones who added this person and would chase them, and seeing that is a read a paused one keeps.
%>
<% name = member.full_name %>
<li id="<%= dom_id member, :row %>" class="list-row items-center<%= " text-muted" unless member.active? %>">
  <div class="avatar avatar-placeholder">
    <div class="bg-base-300 text-base-content w-10 rounded-full">
      <span><%= member.initials %></span>
    </div>
  </div>

  <%# WHY: the name's link is stretched over the whole row, daisyUI's `list-row` being its positioned container, so pressing anywhere on it opens the member while a screen reader still meets one link; Call, Email and the pencil are each lifted above that overlay with `relative z-1`, so the gaps between them still open the member. %>
  <div id="<%= dom_id member %>" class="flex flex-col gap-1">
    <%= link_to name, group_member_path(member.group, member), class: "link link-hover after:absolute after:inset-0" %>

    <div class="flex flex-wrap gap-1">
      <%= render "members/roles", member: %>

      <% if oversees && !member.user.first_signed_in_at? %>
        <span class="badge badge-sm badge-ghost">not signed in yet</span>
      <% end %>
    </div>
  </div>

  <div class="flex flex-none gap-controls">
    <% if member.mobile_phone %>
      <%= phone_to member.mobile_phone, class: "btn btn-ghost btn-circle btn-sm relative z-1", aria: { label: "Call #{name}" } do %>
        <%= icon :call, class: "size-icon-control" %>
      <% end %>
    <% end %>

    <%= mail_to member.email, class: "btn btn-ghost btn-circle btn-sm relative z-1", aria: { label: "Email #{name}" } do %>
      <%= icon :email, class: "size-icon-control" %>
    <% end %>

    <% if manages && !member.pending? %>
      <%= link_to edit_group_member_path(member.group, member), class: "btn btn-ghost btn-circle btn-sm relative z-1 text-primary", aria: { label: "Edit #{name}" } do %>
        <%= icon :edit, class: "size-icon-control" %>
      <% end %>
    <% end %>
  </div>
</li>
