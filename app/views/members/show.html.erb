<% content_for :title, "Showing member" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Showing member</h1>

  <%= render @member %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit this member", edit_group_member_path(@group, @member), class: "btn btn-ghost" %>
    <%= link_to "Back to members", group_members_path(@group), class: "btn btn-ghost" %>
    <%= render "shared/confirm_sheet",
          id: dom_id(@member, :confirm_delete),
          url: group_member_path(@group, @member),
          label: "Remove member",
          title: "Remove this member?",
          body: "They lose access to the group, and every registration they made goes with them. This can't be undone.",
          dismiss: "Keep member" %>
  </div>
</div>
