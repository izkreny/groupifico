<% content_for :title, @member.full_name %>

<%= render "shared/page_header", title: "Member" %>

<%#
  One screen for every reader, per frame 3c: the members table lets every column see each member's
  details. Only the pencil varies, asked of `edit?`, the rule the edit screen authorizes; removing
  a member happens there.
%>
<% name = @member.full_name %>
<%# WHY: `wrap-anywhere` on the whole screen, which every line inherits, because a long one-word name, email or mobile would otherwise push the pencil and the Email and Call buttons off a phone. %>
<div class="flex flex-col gap-4 w-full wrap-anywhere">
  <div id="<%= dom_id @member %>" class="flex items-start gap-3">
    <div class="avatar avatar-placeholder flex-none">
      <div class="bg-base-300 text-base-content w-16 rounded-full">
        <span class="text-xl"><%= @member.initials %></span>
      </div>
    </div>

    <div class="flex flex-col gap-2 grow">
      <div class="flex items-start justify-between gap-2">
        <h2 class="text-record"><%= name %></h2>

        <% if allowed_to?(:edit?, @member) %>
          <%= link_to edit_group_member_path(@group, @member), class: "btn btn-ghost btn-circle btn-sm text-primary flex-none", aria: { label: "Edit" } do %>
            <%= icon :edit, class: "size-icon-control" %>
          <% end %>
        <% end %>
      </div>

      <div class="flex flex-wrap gap-1">
        <%= render "members/roles", member: @member %>
        <span class="badge badge-sm badge-ghost"><%= @member.status %></span>
      </div>
    </div>
  </div>

  <div class="card card-sm bg-base-200">
    <dl class="card-body gap-3">
      <%# Each row is one `div` holding only its `dt` and `dd`, the one wrapper a `dl` admits, so
          the contact button sits inside the `dd` beside the value it acts on. %>
      <%# WHY: each contact's status line sits below its row rather than in it, so the failure sentence it shows never squeezes the value and its buttons. %>
      <div>
        <dt class="text-xs">Email</dt>
        <%= tag.dd data: { controller: "clipboard", clipboard_content_value: @member.email, clipboard_copied_value: "Email copied", clipboard_failed_value: "Couldn't copy. Select the email and copy it yourself." } do %>
          <div class="flex items-center gap-2">
            <span><%= @member.email %></span>

            <%= tag.button type: "button", class: "btn btn-ghost btn-circle btn-sm flex-none", aria: { label: "Copy #{name}'s email" }, data: { clipboard_target: "button", action: "clipboard#copy" } do %>
              <span class="contents" data-clipboard-target="idle"><%= icon :copy, class: "size-icon-control" %></span>
              <span class="contents" hidden data-clipboard-target="done"><%= icon :copied, class: "size-icon-control" %></span>
            <% end %>

            <%= mail_to @member.email, class: "btn btn-ghost btn-circle btn-sm flex-none ms-auto", aria: { label: "Email #{name}" } do %>
              <%= icon :email, class: "size-icon-control" %>
            <% end %>
          </div>

          <p class="text-meta sr-only" role="status" data-clipboard-target="status"></p>
        <% end %>
      </div>

      <% if @member.mobile_phone %>
        <div>
          <dt class="text-xs">Mobile</dt>
          <%= tag.dd data: { controller: "clipboard", clipboard_content_value: @member.mobile_phone, clipboard_copied_value: "Mobile copied", clipboard_failed_value: "Couldn't copy. Select the mobile and copy it yourself." } do %>
            <div class="flex items-center gap-2">
              <span><%= @member.mobile_phone %></span>

              <%= tag.button type: "button", class: "btn btn-ghost btn-circle btn-sm flex-none", aria: { label: "Copy #{name}'s mobile" }, data: { clipboard_target: "button", action: "clipboard#copy" } do %>
                <span class="contents" data-clipboard-target="idle"><%= icon :copy, class: "size-icon-control" %></span>
                <span class="contents" hidden data-clipboard-target="done"><%= icon :copied, class: "size-icon-control" %></span>
              <% end %>

              <%= phone_to @member.mobile_phone, class: "btn btn-ghost btn-circle btn-sm flex-none ms-auto", aria: { label: "Call #{name}" } do %>
                <%= icon :call, class: "size-icon-control" %>
              <% end %>
            </div>

            <p class="text-meta sr-only" role="status" data-clipboard-target="status"></p>
          <% end %>
        </div>
      <% end %>

      <div>
        <dt class="text-xs">Joined</dt>
        <dd><%= member_joined_on @member %></dd>
      </div>
    </dl>
  </div>

  <% if @managed_events.any? %>
    <section class="flex flex-col gap-2" aria-labelledby="manages">
      <h3 id="manages" class="font-semibold">Manages</h3>

      <ul class="list">
        <% @managed_events.each do |event| %>
          <li class="list-row">
            <%# WHY: the name trims rather than wraps, because it links to the event's screen, which draws it whole; `min-w-0` lets the row's cell shrink so the trim can happen. %>
            <div class="min-w-0">
              <%= trimmed event.name, :a, href: group_event_path(@group, event), class: "link link-hover block" %>
              <div class="text-xs"><%= event_schedule_start(event) %></div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
