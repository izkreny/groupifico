<%= form_with(model: [group, member], class: "contents") do |form| %>
  <%= form.with_error_summary do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Member details</legend>

      <%# A new record only: the controller's update never takes an address, so a membership is
          never handed to somebody else, and drawing the field there would offer what it ignores. %>
      <% if member.new_record? %>
        <%= form.field :email, as: :email_field, required: true, autocomplete: "off",
              hint: "They are emailed a link to sign in, and an account is made for a new address." %>
      <% end %>

      <%= form.field :status, as: :select, choices: member_statuses %>
    </fieldset>

    <% if allowed_to?(:manage_roles?, member) %>
      <fieldset class="fieldset">
        <legend class="fieldset-legend">Roles</legend>

        <%= form.collection_check_boxes :roles, Role::NAMES, :itself, :humanize, checked: member.roles.map(&:name) do |box| %>
          <%= box.label class: "label" do %>
            <%= box.check_box class: "checkbox" %>
            <%= box.text %>
          <% end %>
        <% end %>
      </fieldset>
    <% end %>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
