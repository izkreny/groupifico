<%= form_with(model: [group, member], class: "contents") do |form| %>
  <%= form.fields do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Member details</legend>

      <%= form.field :status, as: :select, choices: member_statuses %>
    </fieldset>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
