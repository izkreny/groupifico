<%# locals: (group:, member:, submit:, cancel:) %>
<%= form_with(model: [group, member], class: "contents") do |form| %>
  <%= form.with_error_summary do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Member details</legend>

      <%# A new record only: the controller's update never takes an address, so a membership is
          never handed to somebody else, and drawing the field there would offer what it ignores. %>
      <% if member.new_record? %>
        <%= form.field :email, as: :email_field, required: true, autocomplete: "off",
              hint: "They are emailed a link to sign in, and an account is made for a new address." %>
      <% end %>

      <%= form.segmented_field :status, choices: member_status_choices %>
    </fieldset>

    <%# The hint sits outside the label and reaches the box through `aria-describedby`, so each
        box's accessible name stays the role's own. A greyed row is presentation alone: its box
        stays enabled and posts what it shows, per `role_implications_controller.js`.

        The grey reaches the box and the hint and never the label: daisyUI's `.label` text is
        already mixed down from the content colour, and dimming it further measured 3.28:1 under
        axe at 0.8 in the light theme, below AA. %>
    <% if allowed_to?(:manage_roles?, member) %>
      <fieldset class="fieldset" data-controller="role-implications" data-action="change->role-implications#grey">
        <legend class="fieldset-legend">Roles</legend>

        <%= form.collection_check_boxes :roles, role_choices, :first, :second, checked: member.roles.map(&:name) do |box| %>
          <% _name, _label, hint, implied = box.object %>
          <% hint_id = form.field_id(:roles, box.value, :hint) %>
          <div class="group flex items-center justify-between gap-2"
               data-role-implications-target="role" data-implies="<%= implied.to_json %>">
            <%= box.label class: "label" do %>
              <%= box.check_box class: "checkbox group-data-implied:opacity-80", aria: { describedby: hint_id } %>
              <%= box.text %>
            <% end %>

            <span id="<%= hint_id %>" class="text-xs group-data-implied:opacity-80"><%= hint %></span>
          </div>
        <% end %>
      </fieldset>
    <% end %>
  <% end %>

  <div class="flex gap-2">
    <%= link_to "Cancel", cancel, class: "btn btn-ghost" %>
    <%= form.submit submit, class: "btn btn-primary" %>
  </div>
<% end %>
