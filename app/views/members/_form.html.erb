<%# locals: (group:, member:, submit:, cancel:, fits_at:, namespace: nil, leading: nil) %>
<%# `namespace` is the styleguide's, which draws this form once per theme; every screen leaves it out and keeps its ids. %>
<%= form_with(model: [group, member], namespace:, class: "contents") do |form| %>
  <%= form.with_error_summary do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Member details</legend>

      <%# The address on a new record only, and the status on an existing one only: the controller's update never takes an address, so a membership is never handed to somebody else, and its create takes nothing else, because an invitee starts pending with no role and joins by their own Join. %>
      <% if member.new_record? %>
        <%= form.field :email, as: :email_field, required: true, autocomplete: "off",
              hint: "They are emailed an invitation to join, and an account is made for a new address." %>
      <% else %>
        <%# The start date shows once a status other than the saved one is picked: `:default` matches the radio the page was served with checked. A form sent back over a refused change shows it from the start, since the picked status is then the served one. %>
        <%# WHY: no `required` or `max`, because the browser refuses a hidden field that breaks either and the save then does nothing, with no message to show; the model refuses a blank or later date on this field instead. %>
        <div class="group/status contents">
          <%= form.segmented_field :status, choices: member_status_choices %>
          <div class="<%= class_names("contents" => member.status_changed?, "hidden group-has-[:checked:not(:default)]/status:contents" => !member.status_changed?) %>">
            <%= form.field :status_starts_on, as: :date_field, label: "Starts on", hint: "The day the new status takes effect, today or earlier." %>
          </div>
        </div>
      <% end %>
    </fieldset>

    <%# The hint sits outside the label and reaches the box through `aria-describedby`, so each
        box's accessible name stays the role's own. A greyed row is presentation alone: its box
        stays enabled and posts what it shows, per `role_implications_controller.js`.

        The grey is the theme's `base-content` at 70%, 5.67:1 on light `base-100` and 7.09:1 on
        dark. No grey token in the theme passes in both: `neutral` is 2.14:1 on dark `base-100`.
        WHY the box's label is not daisyUI's `.label`: that component draws its text at 65% of the
        colour it inherits, ahead of any utility, so the grey on top of it fell below AA. These
        are its layout utilities without its colour. %>
    <% if member.persisted? && allowed_to?(:manage_roles?, member) %>
      <fieldset class="fieldset" data-controller="role-implications" data-action="change->role-implications#grey">
        <legend class="fieldset-legend">Roles</legend>

        <%= form.collection_check_boxes :roles, role_choices, :name, :label, checked: member.roles.map(&:name) do |box| %>
          <% choice = box.object %>
          <% hint_id = form.field_id(:roles, box.value, :hint) %>
          <div class="group flex items-center justify-between gap-2"
               data-role-implications-target="role" data-implies="<%= choice.implied.to_json %>">
            <%= box.label class: "inline-flex items-center gap-1.5 group-data-implied:text-muted" do %>
              <%= box.check_box class: "checkbox", aria: { describedby: hint_id } %>
              <%= box.text %>
            <% end %>

            <span id="<%= hint_id %>" class="text-xs group-data-implied:text-muted"><%= choice.hint %></span>
          </div>
        <% end %>
      </fieldset>
    <% end %>
  <% end %>

  <%= render layout: "shared/form_actions", locals: { fits_at:, leading: } do %>
    <%= link_to cancel, class: "btn btn-ghost" do %><%= icon :cancel, class: "size-icon-control" %>Cancel<% end %>
    <%= form.button class: "btn btn-primary" do %><%= icon (member.persisted? ? :save : :send_invite), class: "size-icon-control" %><%= submit %><% end %>
  <% end %>
<% end %>
