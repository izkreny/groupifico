<% content_for :title, "Join #{@group.name}" %>

<div class="grow flex flex-col gap-5">
  <h1 class="text-record text-center break-words">Join <span class="block text-secondary"><%= @group.name %></span></h1>

  <% if authenticated? %>
    <% if @member.nil? %>
      <%= button_to safe_join([ icon(:add_member, class: "size-icon-control"), "Ask to join #{@group.name}" ]), join_request_path,
            params: { token: params[:token] }, class: "btn btn-primary btn-block" %>
    <% elsif @member.pending? %>
      <%# WHY: a pending member is somebody invited, whichever way they reached this page, so both ways in offer the same Join and Decline. %>
      <p class="text-center">You are invited to join this group.</p>

      <%= button_to safe_join([ icon(:add_member, class: "size-icon-control"), "Join #{@group.name}" ]), group_invitation_path(@group),
            method: :patch, class: "btn btn-primary btn-block" %>
      <%= button_to safe_join([ icon(:cancel, class: "size-icon-control"), "Decline" ]), group_invitation_path(@group),
            method: :delete, class: "btn btn-ghost btn-block" %>
    <% elsif @member.inactive? %>
      <p class="text-center">You left this group. Only an owner or administrator can bring you back.</p>
    <% else %>
      <p class="text-center">You are already in this group.</p>

      <%= link_to safe_join([ "Open #{@group.name}", icon(:go_to, class: "size-icon-control") ]), group_path(@group), class: "btn btn-primary btn-block" %>
    <% end %>
  <% else %>
    <%= form_with model: @user, url: join_request_sign_in_link_path, class: "contents" do |form| %>
      <%= hidden_field_tag :token, params[:token] %>

      <%= form.with_error_summary do %>
        <fieldset class="fieldset">
          <%= form.field :email, as: :email_field, label: "Your email", required: true, autofocus: true,
                autocomplete: "username", placeholder: "you@example.com" %>
        </fieldset>
      <% end %>

      <%= form.button class: "btn btn-primary btn-block" do %>
        <%= icon :email, class: "size-icon-control" %> Email me a sign-in link
      <% end %>
    <% end %>

    <p class="text-meta text-center mt-auto">No passwords. The link in the mail signs you in and brings you back here.</p>
  <% end %>
</div>
