<% content_for :title, "Check your email" %>

<div class="grow flex flex-col gap-5">
  <h1 class="text-record text-center">Check your email</h1>

  <p class="text-center break-words">
    A link to confirm your request to join <strong><%= @group.name %></strong> is on its way to
    <strong><%= flash[:sent_to] %></strong>.
  </p>

  <p class="text-meta text-center">It works once and expires in <%= distance_of_time_in_words(0, JoinRequest::EXPIRES_IN) %>. If it does not arrive, check your spam folder.</p>
</div>
