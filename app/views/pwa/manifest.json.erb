  "start_url": "/",
  "display": "standalone",
  "scope": "/",
  "description": "Groupifico.",
  <%# Both copy the light theme's compiled `base-100`. A manifest is parsed by the operating
      system rather than painted by the page, so it cannot reference a daisyUI semantic class and
      cannot switch on the device preference either - `light` is the `--default` theme, so its
      value is the one that belongs here. Hex rather than the `oklch()` the stylesheet carries,
      because manifest parsers across Android and iOS are not something this repository has
      checked. #257 owns the next value, when the organic theme replaces the stock palette. %>
  "theme_color": "#ffffff",
  "background_color": "#ffffff"
}
