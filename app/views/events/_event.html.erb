<%# locals: (event:) %>
<%#
  The record's own facts, as the event screen draws them under its pushed title. Status, when, where
  and who are quiet facts - their icons and plain text colour, as on the hero card.

  Duplicate and Edit are icon buttons in the name's row, each asked of the rule its action
  authorizes: `EventsController#duplicate` authorizes `create?`, so a manager who may edit the
  event is still refused the copy. A refused reader gets no control rather than a disabled one.
%>
<div id="<%= dom_id event %>" class="flex flex-col gap-2">
  <div class="flex items-start justify-between gap-2">
    <%# WHY: `min-w-0`, because a flex item will not shrink below its longest word, so `break-words` alone leaves a long one-word name pushing the buttons off a phone. %>
    <h2 class="text-record min-w-0 break-words"><%= event.name %></h2>

    <div class="flex flex-none gap-controls">
      <% if allowed_to?(:create?, event) %>
        <%= link_to duplicate_group_event_path(event.group, event), class: "btn btn-ghost btn-circle btn-sm text-primary", aria: { label: "Duplicate" } do %>
          <%= icon :duplicate, class: "size-icon-control" %>
        <% end %>
      <% end %>

      <% if allowed_to?(:edit?, event) %>
        <%= link_to edit_group_event_path(event.group, event), class: "btn btn-ghost btn-circle btn-sm text-primary", aria: { label: "Edit" } do %>
          <%= icon :edit, class: "size-icon-control" %>
        <% end %>
      <% end %>
    </div>
  </div>

  <p class="flex items-center gap-icon-text">
    <%= status_icon event, class: "size-icon-inline text-icon-muted" %><%= event_status_line event %>
  </p>

  <p class="flex items-center gap-icon-text">
    <%= icon :when, class: "size-icon-inline text-icon-muted" %><%= event_schedule_range event %>
  </p>

  <% if event.address %>
    <p class="flex items-center gap-icon-text">
      <%= icon :where, class: "size-icon-inline text-icon-muted" %><%= link_to event.address.name, address_map_url(event.address), class: "link link-hover", target: "_blank" %>
    </p>
  <% end %>

  <% if (credits = event_credits(event)) %>
    <p class="flex items-center gap-icon-text">
      <%= icon :members, class: "size-icon-inline flex-none text-icon-muted" %>
      <span><%= credits %></span>
    </p>
  <% end %>

</div>
