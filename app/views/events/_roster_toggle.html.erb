<%# locals: (event:, open: false) %>
<%# Rendered as a `render layout:`, so the block is the roster the summary folds. %>
<%= tag.details class: "collapse collapse-arrow", open:, data: { controller: "keep-open", action: "turbo:before-morph-attribute->keep-open#keep" } do %>
  <%# WHY: the tags move as one block, so a phone puts them all on the line below the title rather than splitting them across both; only the start padding goes, so daisyUI's end padding keeps them clear of the arrow. %>
  <summary class="collapse-title flex flex-col items-start gap-y-2 ps-0 sm:flex-row sm:items-center sm:gap-x-icon-text">
    <span class="font-heading text-row-title mr-tally-rest">Who&rsquo;s coming?</span>
    <span class="flex flex-wrap items-center gap-x-icon-text gap-y-1"><%= render "events/counts", event:, inline: true %></span>
  </summary>

  <div class="collapse-content px-0 pb-0">
    <%= yield %>
  </div>
<% end %>
