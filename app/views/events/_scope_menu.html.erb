<%# locals: (group:, list:, id: "scope") %>
<%#
  The screen's title and its filter in one: the pill names the list that is open, and its menu holds every list as a link, so nothing navigates until one is pressed. The two chevrons swap on `[open]` alone, and the `dropdown` controller closes the menu on a click elsewhere or Escape, which a `<details>` does not do by itself.

  Upcoming is the screen's own URL, with no `scope`, which `EventsController#index` reads as `nil`.
%>
<% lists = { nil => "Upcoming events", "past" => "Past events" } %>
<details id="<%= id %>" class="dropdown group" data-controller="dropdown" data-action="click@document->dropdown#close keydown@document->dropdown#close">
  <summary class="btn btn-ghost bg-base-200 rounded-full px-4 font-normal">
    <%= lists.fetch(list) %>
    <%= icon :disclose, class: "size-icon-control group-open:hidden" %>
    <%= icon :close_panel, class: "size-icon-control hidden group-open:block" %>
  </summary>

  <ul class="dropdown-content menu gap-2 bg-base-100 rounded-box border border-base-300 z-10 mt-2 w-56 p-2 shadow-sm">
    <% lists.each do |scope, name| %>
      <% current = scope == list %>
      <li><%= link_to name, group_events_path(group, scope:), class: { "menu-active" => current }, aria: { current: ("true" if current) } %></li>
    <% end %>
  </ul>
</details>
