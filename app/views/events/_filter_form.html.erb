<%# locals: (group:, filter:, count:, namespace: nil) %>
<%# WHY: apart from `events/filter_sheet` so the styleguide can draw it without a dialog. `namespace` is the styleguide's, as on `groups/join_link`, since it draws this once per theme; the events list leaves it out and keeps its ids, the count frame's among them, which the list's own response has to match, and only the list's copy gets the URL its count reads. %>
<% id = ->(name) { [ namespace, "event_filter", name ].compact.join("_") } %>
<% legend = "mb-2 text-meta font-semibold uppercase tracking-wide text-muted" %>
<% pick = "btn btn-sm rounded-full checked:btn-primary" %>
<div class="flex items-center justify-between gap-2">
  <h2 id="<%= id.(:heading) %>" class="text-lg font-bold">Filter events</h2>

  <form method="dialog">
    <button class="btn btn-ghost btn-circle btn-sm" aria-label="Close"><%= icon :cancel, class: "size-icon-control" %></button>
  </form>
</div>

<%# WHY: the dialog closes as the form submits, because applying picks the list already shows lands on this same URL, a refresh Turbo morphs, and a morph strips `open` without calling `close()`, which leaves the dialog modal and the page refusing clicks. %>
<%= form_with url: group_events_path(group), method: :get, class: "flex flex-col gap-4", data: { controller: "events-filter", action: "change->events-filter#refresh submit->dialog#close", events_filter_url_value: (group_events_path(group) unless namespace) } do %>
  <fieldset>
    <legend class="<%= legend %>">Show</legend>
    <div class="flex flex-wrap gap-2">
      <% Event::Filter::SCOPES.each do |value, name| %>
        <%= radio_button_tag :scope, value.to_s, filter.scope == value, id: id.("scope_#{value || "upcoming"}"), class: pick, aria: { label: name } %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="<%= legend %>">Category</legend>
    <div class="flex flex-wrap gap-2">
      <% Event::Filter::CATEGORIES.each do |value, name| %>
        <%= check_box_tag "category[]", value, filter.categories.include?(value), id: id.("category_#{value}"), class: pick, aria: { label: name } %>
      <% end %>
    </div>
  </fieldset>

  <fieldset>
    <legend class="<%= legend %>">My answer</legend>
    <div class="flex flex-wrap gap-2">
      <% Event::Filter::ANSWERS.each do |value, name| %>
        <%= check_box_tag "answer[]", value, filter.answers.include?(value), id: id.("answer_#{value}"), class: pick, aria: { label: name } %>
      <% end %>
    </div>
  </fieldset>

  <% if filter.managed_offered? %>
    <fieldset>
      <legend class="<%= legend %>">Other</legend>
      <div class="flex flex-wrap gap-2">
        <%= check_box_tag :managed, "1", filter.managed?, id: id.(:managed), class: pick, aria: { label: Event::Filter::MANAGED } %>
      </div>
    </fieldset>
  <% end %>

  <%# WHY: `flex-wrap-reverse` keeps Reset on the left while both fit, and puts "Show N events" on top, full width, once they no longer do. %>
  <div class="flex flex-wrap-reverse gap-2">
    <button type="button" class="btn grow" data-action="events-filter#reset"><%= icon :reset, class: "size-icon-control" %>Reset</button>

    <%# WHY: a count whose response carries no matching frame, such as a lapsed session redirecting to sign-in, is followed as a whole visit, as the join link's frame is, rather than replacing the button with "Content missing". %>
    <%= turbo_frame_tag id.(:count), class: "flex grow", data: { events_filter_target: "count", action: "turbo:frame-missing->dialog#visit" } do %>
      <button class="btn btn-primary grow"><%= icon :apply, class: "size-icon-control" %>Show <%= pluralize count, "event" %></button>
    <% end %>
  </div>
<% end %>
