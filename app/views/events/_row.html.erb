<%# locals: (event:, registration: nil) %>
<%#
  The compact row: the status as its icon alone, the name, and one meta line. No count tags, which
  the legend's matrix reserves for a card: a row competes with every other row beneath it.

  The question is the exception, and it is asked wherever the reader has been invited and has not
  answered - a row is where they are looking when they decide. An answer already given stays an
  icon beside the name rather than a second set of pills. `list-col-wrap` puts the question on its
  own line under the row rather than in a column beside it.
%>
<li id="<%= dom_id event %>" class="list-row">
  <%= status_icon event, label: event.status, class: "size-5" %>

  <div>
    <%= link_to event.name, group_event_path(event.group, event), class: "link link-hover" %>
    <% if registration&.answered? %>
      <%= status_icon registration, label: "your answer: #{registration.status}", class: "size-4 inline-block align-text-bottom" %>
    <% end %>

    <div class="text-xs">
      <%= event_schedule_start(event) %>
      <% if event.address %>
        · <%= link_to event.address.name, address_map_url(event.address), class: "link link-hover" %>
      <% end %>
    </div>
  </div>

  <% if registration&.invited? %>
    <div class="list-col-wrap">
      <%= render "events/rsvp", event: event, registration: registration %>
    </div>
  <% end %>
</li>
