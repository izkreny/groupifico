<%= form_with(model: [group, event], class: "contents") do |form| %>
  <%= form.fields do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Event details</legend>

      <%= form.field :name %>
      <%= form.field :description, as: :text_area %>
      <%= form.field :starts_at,   as: :datetime_field %>
      <%= form.field :ends_at,     as: :datetime_field %>
      <%= form.field :status,      as: :select, choices: event_statuses %>
      <%= form.field :category,    as: :select, choices: event_categories %>
      <%= form.field :manager_id,  as: :select, choices: member_choices(event.group.members) %>

      <% if event.group.addresses.present? %>
        <div class="divider"></div>
        <strong>
          <%= event.address&.persisted? ? "Change address:" : "Select existing address:" %>
        </strong>

        <%= form.field :address_id, as: :select, choices: address_choices(event.group.addresses), prompt: true %>
      <% end %>

      <% if event.address&.persisted? %>
        <div class="mt-2">
          <%= link_to "Edit '#{event.address.name}' address", edit_address_path(event.address), target: "_blank", class: "link link-hover" %>
        </div>
      <% else %>
        <div class="divider"></div>
        <strong>Create new address:</strong>

        <%= form.fields_for :address do |address_form| %>
          <%= render "addresses/form_fields", form: address_form %>
        <% end %>
      <% end %>
    </fieldset>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
