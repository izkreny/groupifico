<%# locals: (group:, event:, submit:, cancel:, original: nil, namespace: nil) %>
<%# `namespace` is the styleguide's, which draws this form once per theme; every screen leaves it out and keeps its ids. %>
<%= form_with(model: [group, event], namespace:, class: "contents") do |form| %>
  <%# WHY: posted beside the event rather than in it, because it names the duplicate screen's source,
      which only a refused save in `EventsController#create` reads, to draw that screen again. %>
  <% if original %>
    <%= hidden_field_tag :original_id, original.id %>
  <% end %>

  <%= form.with_error_summary do %>
    <div class="fieldset">
      <%= form.field :name %>
      <%= form.segmented_field :status, choices: event_statuses %>
      <%= form.segmented_field :category, choices: event_categories %>
      <%= form.field :starts_at, as: :datetime_field %>
      <%= form.field :ends_at, as: :datetime_field, hint: "Typed and shown in #{Time.zone.tzinfo.name}" %>
    </div>

    <%# Frames 4e, 4f and 4k: this group's addresses, each used as it is, and a new one written
        here. A picked row offers the one screen that corrects it, where `AddressPolicy` asks its
        own question - which for the group's home address is the owner's alone.

        The new-address fields are always in the page, so they post whichever row is picked;
        `EventsController#event_params` drops them whenever an `address_id` arrives. They are drawn
        for a fresh address unless the event's own is unsaved, which is a refused save keeping what
        was typed: the event's saved address drawn here would be cloned by every plain Save. %>
    <fieldset class="fieldset">
      <legend class="label">Where</legend>

      <% group.addresses.each do |address| %>
        <div class="flex items-center gap-2">
          <%= form.radio_button :address_id, address.id, class: "radio radio-sm peer" %>
          <%= form.label :address_id, where_choice_label(address), value: address.id, class: "grow min-w-0" %>

          <% if allowed_to?(:update?, address) %>
            <%= link_to "Correct it", edit_address_path(address), target: "_blank", class: "link hidden peer-checked:inline flex-none" %>
          <% end %>
        </div>
      <% end %>

      <% new_address = event.address&.new_record? ? event.address : Address.new %>
      <div class="group grid gap-2">
        <div class="flex items-center gap-2">
          <%= form.radio_button :address_id, "", checked: new_address.changed?, class: "radio radio-sm" %>
          <%= form.label :address_id, "New address…", value: "" %>
        </div>

        <div class="hidden group-has-checked:block">
          <%= form.fields_for :address, new_address do |address_form| %>
            <%= render "addresses/form_fields", form: address_form %>
          <% end %>
        </div>
      </div>
    </fieldset>

    <div class="fieldset">
      <%= form.field :manager_id, as: :select, choices: manager_choices(event) %>
      <%= form.field :description, as: :text_area %>
    </div>

    <%# Frames 4e, 4f and 4k: asks everyone who is active and not yet on the list, once the event is
        saved. Drawn for a reader the invitation row admits, the question `EventsController` asks. %>
    <% if allowed_to?(:create?, Registration.new(event: event)) %>
      <fieldset class="fieldset">
        <label class="label">
          <%= form.check_box :invite_active_members, class: "checkbox" %>
          Invite all active members
        </label>
      </fieldset>
    <% end %>
  <% end %>

  <div class="flex flex-wrap items-center gap-2 mt-4">
    <%= link_to "Cancel", cancel, class: "btn btn-ghost" %>
    <%= form.submit submit, class: "btn btn-primary" %>
  </div>
<% end %>
