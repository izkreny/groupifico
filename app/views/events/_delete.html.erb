<%# locals: (group:, event:, id: dom_id(event, :confirm_delete), detached: false) %>
<%# The event's delete confirmation, drawn by the edit screen, detached from its trigger in the form's
    button row, which keeps its own `destroy?` gate. `id` is the styleguide's, which draws this once
    per theme; the screen leaves it out. %>
<%= render "shared/confirm_sheet",
      id:,
      url: group_event_path(group, event),
      confirm: "Delete event",
      title: "Delete this event?",
      body: "Every registration for it goes too. This can't be undone.",
      dismiss: "Keep event",
      detached: %>
