<%# locals: (group:, event:, id: dom_id(event, :confirm_delete)) %>
<%# The event's delete confirmation, drawn by the detail screen and the edit screen, which frame 4k
    says both keep. Each screen keeps its own `destroy?` gate and spacing around this. `id` is the
    styleguide's, which draws this once per theme; every screen leaves it out. %>
<%= render "shared/confirm_sheet",
      id:,
      url: group_event_path(group, event),
      confirm: "Delete event",
      title: "Delete this event?",
      body: "Every registration for it goes too. This can't be undone.",
      dismiss: "Keep event" %>
