<%# locals: (event:) %>
<%#
  Who is on the event's list, one row per registration in the `Event#roster` order the reader last chose, the same rows for every reader: what varies is only the order and what a reader may do with a row.

  The two capabilities are the reader's rather than a row's, so each is checked once, against a
  registration with no member on it - the record `EventsController#update` checks before changing the list. With no member
  `own?` is false, so `update?` there is "change another member's answer" alone; checked per row it
  would hand a plain member controls on their own row. `Registration.new(event:)` rather than
  `event.registrations.new`, which would join the loaded association `events/_counts` sizes.

  A row whose pills already say where it stands draws no status icon beside them. An unanswered row keeps
  its status icon, because no pill is current there to tell `reserved` from `response_requested`. A reader who may request gets the paper plane beside it: plain on a `reserved` row, which it moves, and tinted on a `response_requested` one, which has moved already and stays as it is, where the plane alone says it, so the row draws no second one. A paused
  or inactive member's row keeps its status icon alone, because they never get a request.

  The pills are `Event#available_registration_answers`, so once the event has ended a maybe given before it has no pill to light, and its row keeps the status icon as an unanswered one does.

  The pills also wait on `Event#open_to_answers?`, as on `events/_row`: `Registration` refuses every
  answer on an event that is over, so a pill there is a control certain to fail. Editing the list does
  not, since correcting a roster after the fact is still the three roles' business.
%>
<% unattached = Registration.new(event: event) %>
<% may_fill = allowed_to?(:create?, unattached) %>
<% may_answer = event.open_to_answers? && allowed_to?(:update?, unattached) %>
<% answers = event.available_registration_answers %>
<% anyone_to_request = may_fill && event.anyone_left_to_request? %>
<% anyone_to_reserve = may_fill && event.anyone_left_to_reserve? %>
<% order = roster_order %>
<% roster = event.roster(order:) %>

<div class="flex flex-col gap-2">
  <div>
    <h3 class="font-semibold">Who&rsquo;s on the list</h3>
    <p class="text-xs">
      <%= list_tally(event.group, event) %><% if (left_out = left_out_line(event.group, event)) %> · <%= left_out %><% end %>
    </p>
  </div>

  <%# WHY: daisyUI fills a button carrying aria-current as active, so the lit pill clears that fill at rest to stay chosen by its colour alone, and keeps the hover every button has. %>
  <%# The Who's coming? tally's colours: the chosen answer in its status colour and a question in info, every control not yet used in the muted icon ink, and a row's status icon drawn where no control stands, as the tally draws it. %>
  <% if roster.any? %>
    <table class="table">
      <thead>
        <tr>
          <%# WHY: each header is a form rather than a link, because choosing an order stores it, and a GET writes nothing. The same glyph on both, inked on the one the list is in, because neither order reverses on a second press. %>
          <% { "name" => "Member", "status" => "Status" }.each do |value, heading| %>
            <% sorted = order == value %>
            <%= tag.th scope: "col", class: [ "px-0", ("text-end" if value == "status") ], aria: { sort: ("ascending" if sorted) } do %>
              <%= button_to safe_join([ heading, icon(:sort, class: "size-icon-inline #{"text-icon-muted" unless sorted}") ]),
                    group_event_roster_order_path(event.group, event),
                    method: :patch,
                    params: { order: value },
                    class: "btn btn-ghost btn-sm gap-x-icon-text px-1" %>
            <% end %>
          <% end %>
        </tr>
      </thead>

      <tbody>
        <% roster.each do |registration| %>
          <% name = registration.member.full_name %>
          <tr id="<%= dom_id registration, :roster %>">
            <td class="px-0 py-2 wrap-anywhere"><%= name %></td>

            <td class="px-0 py-2">
              <%# WHY: one strip at one gap, so every status icon on the row sits the same distance from its neighbours whichever controls the reader gets. %>
              <div class="flex items-center justify-end gap-controls">
                <% requestable = may_fill && !registration.answered? && registration.member.active? %>
                <% requested = registration.response_requested? %>
                <% if (!may_answer || answers.exclude?(registration.status)) && !(requestable && requested) %>
                  <span class="inline-flex size-control items-center justify-center <%= status_ink(registration.status) %>" title="<%= registration_status_label(registration) %>">
                    <%= status_icon registration, label: registration_status_label(registration), class: "size-icon-control" %>
                  </span>
                <% end %>

                <% if requestable %>
                  <%= button_to group_event_registration_response_request_path(event.group, event, registration),
                        class: "btn btn-ghost btn-sm btn-square #{requested ? "text-info" : "text-icon-muted"}",
                        title: registration_status_label(registration),
                        aria: { label: requested ? "Response requested from #{name}" : "Request a response from #{name}" } do %>
                    <%= icon :response_requested, class: "size-icon-control" %>
                  <% end %>
                <% end %>

                <% if may_answer %>
                  <% answers.each do |answer| %>
                    <% current = registration.status == answer %>
                    <%= button_to group_event_registration_path(event.group, event, registration),
                          method: :patch,
                          params: { registration: { status: answer } },
                          class: "btn btn-ghost btn-sm btn-square #{current ? "#{status_ink(answer)} not-hover:bg-transparent not-hover:border-transparent" : "text-icon-muted"}",
                          aria: { label: "#{answer.capitalize} for #{name}", current: (current ? "true" : nil) } do %>
                      <%= icon answer, class: "size-icon-control" %>
                    <% end %>
                  <% end %>
                <% end %>
              </div>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% else %>
    <p class="text-sm">Nobody is on the list yet.</p>
  <% end %>

  <% if anyone_to_reserve || anyone_to_request %>
    <div class="flex flex-wrap gap-2">
      <%# Each only while it can do something: every active member already listed, or already requested, leaves it nothing. %>
      <% if anyone_to_reserve %>
        <%= button_to group_event_reservation_path(event.group, event), class: "btn btn-sm" do %>
          <%= icon :reserved, class: "size-icon-control" %>Reserve a place for everyone
        <% end %>
      <% end %>

      <% if anyone_to_request %>
        <%= button_to group_event_response_request_path(event.group, event), class: "btn btn-sm" do %>
          <%= icon :response_requested, class: "size-icon-control" %>Request the rest
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
