<%# locals: (group:, filter:, count:) %>
<%# WHY: a bottom sheet on a phone and a centred dialog wider up, as the join link's is, so the app's dialogs open one way. %>
<dialog id="event_filter_dialog" class="modal modal-bottom sm:modal-middle" aria-labelledby="event_filter_heading" data-dialog-target="sheet">
  <div class="modal-box flex flex-col gap-4">
    <%= render "events/filter_form", group:, filter:, count: %>
  </div>

  <form method="dialog" class="modal-backdrop">
    <button>close</button>
  </form>
</dialog>
