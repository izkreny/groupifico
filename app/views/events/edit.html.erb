<% content_for :title, "Edit event" %>

<%= render "shared/page_header", title: "Edit event", back: group_event_path(@group, @event) %>

<%# The delete leads the form's button row, as on every edit screen, with its sheet detached below the form, since a form cannot hold the sheet's own. `destroy?` rather than the `edit?` that admitted the reader, because the event's manager may edit it and may not delete it. %>
<% deletable = allowed_to?(:destroy?, @event) %>
<% id = dom_id(@event, :confirm_delete) %>
<%= render layout: "shared/confirm_scope", locals: { enabled: deletable, classes: "w-full" } do %>
  <%= render "events/form", group: @group, event: @event, submit: "Save changes", cancel: group_event_path(@group, @event),
        leading: (render("shared/confirm_trigger", id:, confirm: "Delete event") if deletable) %>

  <% if deletable %>
    <%= render "events/delete", group: @group, event: @event, id:, detached: true %>
  <% end %>
<% end %>
