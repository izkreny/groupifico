<% content_for :title, "Edit event" %>

<%= render "shared/page_header", title: "Edit event" %>

<div class="w-full">
  <%= render "events/form", group: @group, event: @event, submit: "Save changes", cancel: group_event_path(@group, @event) %>

  <%# Below the form rather than in its button row, where frame 4k draws it: the sheet's trigger is
      a `button_to`, and a form cannot hold another. `destroy?` rather than the `edit?` that
      admitted the reader, because the event's manager may edit it and may not delete it. %>
  <% if allowed_to?(:destroy?, @event) %>
    <div class="mt-10">
      <%= render "shared/confirm_sheet",
            id: dom_id(@event, :confirm_delete),
            url: group_event_path(@group, @event),
            confirm: "Delete event",
            title: "Delete this event?",
            body: "Every registration for it goes too. This can't be undone.",
            dismiss: "Keep event" %>
    </div>
  <% end %>
</div>
