<% content_for :title, "Duplicate event" %>

<%= render "shared/page_header", title: "Duplicate event" %>

<div class="w-full">
  <div role="status" class="alert mb-4">
    <%= icon :duplicate, class: "size-6 shrink-0" %>

    <span>Copied from <%= @original.starts_at.strftime(EventsHelper::DATE_FORMAT) %>. Dates moved on 7 days, status back to unconfirmed, nobody registered yet.</span>
  </div>

  <%= render "events/form", group: @group, event: @event, submit: "Create copy", cancel: group_event_path(@group, @original), original: @original %>
</div>
