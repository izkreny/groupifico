<% content_for :title, "Events" %>

<%# WHY: the list and every filter are chosen in one place, the funnel's sheet, so the screen needs no list menu and its title is simply "Events"; the chips under it say what is on. %>
<div class="flex flex-col gap-3">
  <div class="flex flex-col gap-3" data-controller="dialog" data-action="turbo:before-cache@document->dialog#close">
    <div class="flex items-center justify-between gap-2.5">
      <h2 class="font-heading text-hero">Events</h2>

      <div class="flex items-center gap-controls">
        <%# Checked against a new event rather than the group, because that is the record `EventPolicy`
            writes the rule against. A refused reader gets no button rather than a disabled one. %>
        <% if allowed_to?(:create?, @group.events.new) %>
          <%= link_to new_group_event_path(@group), class: "btn btn-ghost btn-circle btn-sm text-primary", aria: { label: "New event" } do %>
            <%= icon :new, class: "size-icon-control" %>
          <% end %>
        <% end %>

        <%# WHY: primary only while a filter hides events from the list picked, and muted otherwise, whichever list is open, since the list's own chip already names it. %>
        <% funnel_ink = @filter.narrowed? ? "text-primary" : "text-icon-muted" %>
        <%= tag.button type: "button", class: [ "btn btn-ghost btn-circle btn-sm", funnel_ink ], aria: { label: "Filter events" }, data: { dialog_target: "trigger", action: "dialog#show" } do %>
          <%= icon :filter, class: "size-icon-control" %>
        <% end %>
      </div>
    </div>

    <%= render "events/filter_chips", group: @group, filter: @filter %>
    <%= render "events/filter_sheet", group: @group, filter: @filter, count: @events.load.size %>
  </div>

  <% reader = Current.member %>
  <div id="events">
    <% if @events.any? %>
      <ul class="list">
        <% @events.each do |event| %>
          <%= render "events/row", event: event, registration: event.registration_for(reader) %>
        <% end %>
      </ul>
    <% elsif @filter.narrowed? %>
      <p class="text-meta">No events match these filters.</p>
    <% else %>
      <p class="text-meta"><%= { "past" => "No past events.", "canceled" => "No canceled events." }.fetch(@filter.scope, "Nothing coming up.") %></p>
    <% end %>
  </div>
</div>
