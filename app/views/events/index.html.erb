<% content_for :title, "Events" %>

<div class="w-full">
  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl"><%= link_to @group.name, group_path(@group) %> Events</h1>
    <%= link_to "New event", new_group_event_path(@group), class: "btn btn-primary" %>
  </div>

  <% reader = Current.member %>

  <% if @next_event %>
    <%= render "events/next_up", event: @next_event, registration: @next_event.registration_for(reader) %>
  <% end %>

  <div id="events">
    <% rows = @events.reject { it.id == @next_event&.id } %>
    <% if rows.any? %>
      <ul class="list">
        <% rows.each do |event| %>
          <%= render "events/row", event: event, registration: event.registration_for(reader) %>
        <% end %>
      </ul>
    <% elsif @next_event.nil? %>
      <p class="text-center my-10">No events found.</p>
    <% end %>
  </div>
</div>
