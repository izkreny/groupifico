<%# locals: (group:, filter:) %>
<%# WHY: each ✕ is a link to the list with everything else still on, since the URL is the only place a filter lives, and "Clear all" is a plain text link with no ✕, so it reads neither as one more filter nor as one chip's remove. %>
<% if filter.narrowed? %>
  <div class="flex flex-wrap gap-2">
    <% filter.chips.each do |name, params| %>
      <div class="inline-flex items-center rounded-full bg-primary text-primary-content">
        <button type="button" class="ps-3 py-1 text-sm cursor-pointer" data-action="dialog#show"><%= name %></button>
        <%= link_to icon(:remove, class: "size-icon-inline"), group_events_path(group, params), class: "btn btn-ghost btn-circle btn-xs text-primary-content", aria: { label: "Remove #{name}" } %>
      </div>
    <% end %>

    <%= link_to "Clear all", group_events_path(group, filter.cleared), class: "link self-center text-sm" %>
  </div>
<% end %>
