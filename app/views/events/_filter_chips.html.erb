<%# locals: (group:, filter:) %>
<%# WHY: each chip is one link to the list with everything else still on, as Fizzy's filter chips are, since the URL is the only place a filter lives and the funnel is what opens the sheet; "Clear all" is a plain text link with no ✕, so it reads neither as one more filter nor as one chip's remove. %>
<% if filter.narrowed? %>
  <%# WHY: 16px from the tabs' line and 16px from the first row's text; that row already starts its text 16px down, so its own padding is the space under the chips and the gap below them is taken back. %>
  <div class="mt-1 -mb-3 flex flex-wrap gap-2">
    <% filter.chips.each do |name, params| %>
      <%= link_to group_events_path(group, params), class: "inline-flex items-center gap-1 rounded-full bg-primary py-1.5 ps-3 pe-2 text-sm text-primary-content", aria: { label: "Remove #{name}" } do %>
        <%# WHY: trimmed to its x-height, as the app's badges are, so the ✕ centres on the lowercase letters a label is mostly made of rather than on a line box that keeps descender room; the extra 2px of padding keeps the chip 28px tall. %>
        <span class="[text-box:trim-both_ex_alphabetic]"><%= name %></span><%= icon :remove, class: "size-icon-inline" %>
      <% end %>
    <% end %>

    <%= link_to "Clear all", group_events_path(group, filter.cleared), class: "link ms-1 self-center text-sm" %>
  </div>
<% end %>
