<%# locals: (event:, registration: nil) %>
<%#
  The hero card, tinted because it competes with the rows beneath it. Status, when and where are
  quiet facts: their icons and plain text colour, no accent. It renders the counts and the answer
  row itself, because the legend's matrix gives every cell that shows tags the answer row under
  them, and a screen that had to remember to render all three would be a screen that can forget.
%>
<div id="<%= dom_id event, :next_up %>" class="card card-sm bg-base-200">
  <div class="card-body gap-2">
    <p class="text-xs"><%= event_kicker event %></p>

    <%# Frame 4h's pencil at the end of the name's row, with Duplicate before it, each asked of the rule its action authorizes as on the event screen (`events/_event` carries why Duplicate asks `create?`), so a reader refused one gets no control. %>
    <div class="flex items-center justify-between gap-2">
      <h2 class="card-title min-w-0 break-words">
        <%= link_to event.name, group_event_path(event.group, event), class: "link link-hover" %>
      </h2>

      <div class="flex flex-none gap-2">
        <% if allowed_to?(:create?, event) %>
          <%= link_to duplicate_group_event_path(event.group, event), class: "btn btn-ghost btn-circle btn-sm text-primary", aria: { label: "Duplicate #{event.name}" } do %>
            <%= icon :duplicate, class: "size-5" %>
          <% end %>
        <% end %>

        <% if allowed_to?(:edit?, event) %>
          <%= link_to edit_group_event_path(event.group, event), class: "btn btn-ghost btn-circle btn-sm text-primary", aria: { label: "Edit #{event.name}" } do %>
            <%= icon :edit, class: "size-5" %>
          <% end %>
        <% end %>
      </div>
    </div>

    <p class="flex items-center gap-1.5">
      <%= status_icon event, class: "size-4 text-icon-muted" %><%= event_status_line event %>
    </p>

    <p class="flex items-center gap-1.5">
      <%= icon :when, class: "size-4 text-icon-muted" %><%= event_schedule_range event %>
    </p>

    <% if event.address %>
      <p class="flex items-center gap-1.5">
        <%= icon :where, class: "size-4 text-icon-muted" %><%= link_to event.address.name, address_map_url(event.address), class: "link link-hover", target: "_blank" %>
      </p>
    <% end %>

    <%= render "events/counts", event:, roster_link: true %>

    <%# Frame 4n: an event whose every registration is a place held and nobody asked. It needs one
        registration at least, since "every" holds of an empty list that has nobody to ask. %>
    <% if event.registrations.any? && event.registrations.all?(&:reserved?) && allowed_to?(:create?, Registration.new(event: event)) %>
      <%= button_to group_event_invitation_path(event.group, event), class: "btn btn-sm self-start" do %>
        <%= icon :invited, class: "size-4" %>Invite everyone
      <% end %>
    <% end %>

    <%= render "events/rsvp", event: event, registration: registration %>
  </div>
</div>
