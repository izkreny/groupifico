<%# locals: (id:, url:, confirm:, title:, body:, dismiss:, word: nil, block: nil, detached: false) %>
<%#
  `word` makes this the type-to-confirm variant, and `block` names why the delete cannot happen
  yet. A block leaves the comparing controller unwired, so the primary stays disabled whatever is
  typed; the record's own guard is still what refuses.

  The field belongs to no form, deliberately. The trigger form's default button is the trigger
  itself, which is never disabled, so a field that form owned would submit the delete on Enter
  without the word ever being compared.

  `detached` is an edit screen's, whose trigger stands in its form's button row, drawn there by
  `shared/confirm_trigger`: a form cannot hold another, so the delete form stays out here empty and
  the trigger joins it through its `form` attribute. Such a screen wraps its form and this in
  `shared/confirm_scope` itself, since the controller has to see the trigger.
%>
<%= render layout: "shared/confirm_scope", locals: { enabled: !detached } do %>
  <% if detached %>
    <form id="<%= id %>_form" action="<%= url %>" method="post" class="hidden">
      <%= hidden_field_tag :_method, "delete", id: nil %>
      <%= hidden_field_tag :authenticity_token, form_authenticity_token, id: nil %>
    </form>
  <% else %>
    <%= button_to safe_join([ icon(:delete, class: "size-5"), confirm ]), url, method: :delete, class: "btn btn-error",
          form: { id: "#{id}_form" }, data: { dialog_target: "trigger" } %>
  <% end %>

  <%#
    The comparing controller sits on the `<dialog>` because `close` does not bubble, and each
    attempt starts from an empty field: a word typed before the sheet was dismissed, or before
    Turbo cached the page, would otherwise reopen it with the primary already enabled.
  %>
  <dialog id="<%= id %>" class="modal modal-bottom sm:modal-middle"
          aria-labelledby="<%= id %>_title"
          aria-describedby="<%= [ "#{id}_body", ("#{id}_block" if block) ].compact.join(" ") %>"
          data-dialog-target="sheet"
          <% if word && !block %><%= tag.attributes(data: { controller: "type-to-confirm", type_to_confirm_word_value: word,
                action: "close->type-to-confirm#reset turbo:before-cache@document->type-to-confirm#reset" }) %><% end %>>
    <div class="modal-box">
      <h3 id="<%= id %>_title" class="text-lg font-bold"><%= title %></h3>
      <p id="<%= id %>_body" class="py-4"><%= body %></p>

      <% if block %>
        <%= render layout: "shared/alert", locals: { kind: :error, id: "#{id}_block" } do %>
          <span><%= block %></span>
        <% end %>
      <% end %>

      <% if word %>
        <fieldset class="fieldset">
          <label class="label" for="<%= id %>_word">Type <%= word %> to confirm</label>
          <input type="text" id="<%= id %>_word" class="input w-full" autocomplete="off"
                 data-type-to-confirm-target="field" data-action="type-to-confirm#compare">
        </fieldset>
      <% end %>

      <div class="modal-action">
        <form method="dialog">
          <button class="btn btn-sm"><%= icon :cancel, class: "size-5" %><%= dismiss %></button>
        </form>

        <%= tag.button form: "#{id}_form", class: "btn btn-sm btn-error",
              disabled: word.present? || block.present?,
              data: { type_to_confirm_target: ("primary" if word) } do %>
          <%= icon :delete, class: "size-5" %><%= confirm %>
        <% end %>
      </div>
    </div>

    <form method="dialog" class="modal-backdrop">
      <button>close</button>
    </form>
  </dialog>
<% end %>
