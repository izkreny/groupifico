<% content_for :title, "Sign in" %>

<div class="flex flex-col gap-5">
  <%# The account is named so a link somebody else sent you is recognisable, which is the whole
      reason this GET renders a page instead of signing anybody in. %>
  <h1 class="text-record">Sign in as <%= @sign_in_token.user.email %></h1>

  <div class="inline">
    <%= button_to "Sign in", sign_in_path, class: "btn btn-primary" %>
  </div>

  <%# Copy, not a route: closing the page leaves the link unspent until it expires, so there is
      nowhere for a link here to lead. %>
  <p class="label">Not you? Just close this page</p>

  <p class="label">Opening the link did nothing yet. Only this button signs you in, and the link then stops working.</p>
</div>
