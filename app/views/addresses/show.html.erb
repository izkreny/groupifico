<% content_for :title, @address.name %>

<%= render "shared/page_header", title: "Place" %>

<div class="flex flex-col gap-4 w-full">
  <%= render "addresses/address", address: @address %>

  <% if @events.any? %>
    <section class="flex flex-col gap-2" aria-labelledby="used_by">
      <h3 id="used_by" class="font-semibold">Used by</h3>

      <ul class="list">
        <% @events.each do |event| %>
          <li class="list-row">
            <div>
              <%= link_to event.name, group_event_path(event.group, event), class: "link link-hover" %>
              <div class="text-xs"><%= event_schedule_start(event) %></div>
            </div>
          </li>
        <% end %>
      </ul>
    </section>
  <% end %>
</div>
