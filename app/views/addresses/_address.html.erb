<%# locals: (address:) %>
<%#
  The place's own facts under the pushed title, in frame 9k's order. The street is the map link, as
  every address in the app is, and Correct sits in the name's row the way Edit does on the event
  screen: asked of `update?`, which reserves a group's home address to that group's owner. There is
  no delete here or anywhere, since every address a member can reach is held by an ON DELETE
  RESTRICT reference.
%>
<div id="<%= dom_id address %>" class="flex flex-col gap-2">
  <div class="flex items-start justify-between gap-2">
    <h2 class="text-record"><%= address.name %></h2>

    <% if allowed_to?(:update?, address) %>
      <%= link_to "Correct", edit_address_path(address), class: "btn btn-sm flex-none" %>
    <% end %>
  </div>

  <address class="flex flex-col not-italic">
    <% if (street = address_street(address)).present? %>
      <%= link_to street, address_map_url(address), class: "link link-hover" %>
    <% end %>
    <% if (area = address_area(address)).present? %>
      <span><%= area %></span>
    <% end %>
    <% if address.country_code.present? %>
      <span><%= address.country_code %></span>
    <% end %>
  </address>

  <% if address.group %>
    <p><%= address.group.name %> · home address</p>
  <% end %>
</div>
