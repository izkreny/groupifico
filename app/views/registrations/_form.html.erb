<%= form_with(model: [group, event, registration], class: "contents") do |form| %>
  <% fields = capture do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Registration details</legend>

      <%= form.field :member_id, as: :select, choices: member_choices(members_available(group, event)) %>
      <%= form.field :status,    as: :select, choices: registration_statuses %>
    </fieldset>
  <% end %>

  <%= render "shared/errors", form: form %>
  <%= fields %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
