<% content_for :title, "Your groups" %>

<%#
  The one screen above the group shell: no tabs, no group mark, no switcher. `shell_tabs?` already
  answers false here because `groups#index` has no group, so nothing is suppressed by hand.
%>
<h1 class="text-shell sm:text-hero">Your groups</h1>

<div id="groups" class="mt-3 flex flex-col gap-3">
  <% @groups.each do |group| %>
    <%= render group, membership: @memberships[group.id] %>
  <% end %>

  <%# A reader who has left every group they were in. Rare, but the button alone below reads as a
      screen that failed to load rather than as one with nothing on it. %>
  <% if @groups.none? %>
    <p class="text-meta">You are not in a group yet.</p>
  <% end %>

  <%= link_to new_group_path, class: "btn btn-primary btn-block" do %>
    <%= icon :new, class: "size-4" %>New group
  <% end %>
</div>
