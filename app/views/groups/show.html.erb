<% content_for :title, @group.name %>

<%#
  The group's home. The name, the mark, the switcher and the pencil are all the shell's, drawn by
  `layouts/_header`, so this screen starts at the hero and never repeats the title.
%>
<%# The first-run screen is for a group with no events at all, so a group whose events are all past, unconfirmed or `other` still gets the two cards, each saying nothing of its kind is ahead. %>
<% if @group.events.exists? %>
  <div class="grid gap-4 md:grid-cols-2">
    <% [ [ "rehearsal", @next_rehearsal ], [ "gig", @next_gig ] ].each do |category, event| %>
      <% if event %>
        <%= render "events/next_up", event:, registration: event.registration_for(@membership) %>
      <% else %>
        <div id="no_<%= category %>" class="card card-sm bg-base-200">
          <p class="card-body text-base-content/70">No <%= category %> coming up</p>
        </div>
      <% end %>
    <% end %>
  </div>
<% else %>
  <div class="flex flex-col items-start gap-3 py-10">
    <h2 class="text-record">Nothing in the diary</h2>

    <%# Checked here rather than at the top of the template, so the populated branch pays for neither
        the built event nor the policy resolution behind it. `EventPolicy#create?` is checked against a new
        event rather than the group, because that is the record the rule is written against; a
        refused reader gets no control rather than a disabled one. %>
    <% if allowed_to?(:create?, @group.events.new) %>
      <p>Add your first rehearsal, then request a response from everyone.</p>

      <%= link_to new_group_event_path(@group), class: "btn btn-primary" do %>
        <%= icon :new, class: "size-icon-control" %>New event
      <% end %>
    <% end %>

    <%# The invite route arrives with #208, so the call to action is text until it exists: a link
        that lands nowhere is worse than a sentence that requests one. %>
    <% if @group.current_members.one? %>
      <p class="mt-4 rounded-box bg-base-200 p-4 text-meta">It&rsquo;s just you in here so far. Invite the others</p>
    <% end %>
  </div>
<% end %>
