<% content_for :title, "Showing group" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Showing group</h1>

  <%= render @group %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit this group", edit_group_path(@group), class: "btn btn-ghost" %>
    <%= link_to "Back to groups", groups_path, class: "btn btn-ghost" %>
    <%= render "shared/confirm_sheet",
          id: dom_id(@group, :confirm_delete),
          url: group_path(@group),
          label: "Delete group",
          title: "Delete this group?",
          body: "Every member, event and registration goes with it. This can't be undone.",
          dismiss: "Keep group" %>
  </div>
</div>
