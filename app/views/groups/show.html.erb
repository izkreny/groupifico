<% content_for :title, @group.name %>

<%#
  The group's home. The name, the mark, the switcher and the pencil are all the shell's, drawn by
  `layouts/_header`, so this screen starts at the hero and never repeats the title.

  `EventPolicy#create?` is asked of a new event rather than of the group, because that is the record
  the rule is written against; a refused reader gets no control rather than a disabled one.
%>
<% may_add_event = allowed_to?(:create?, @group.events.new) %>

<% if @next_event %>
  <div class="flex flex-col gap-3">
    <%= render "events/next_up", event: @next_event, registration: @next_event.registration_for(@membership) %>

    <%= link_to group_events_path(@group), class: "link link-hover inline-flex items-center gap-1 text-card-fact" do %>
      See all events<%= icon :go_to, class: "size-4" %>
    <% end %>
  </div>
<% else %>
  <div class="flex flex-col items-start gap-3 py-10">
    <h2 class="text-record">Nothing in the diary</h2>

    <% if may_add_event %>
      <p>Add your first rehearsal and everyone gets asked whether they&rsquo;re coming.</p>

      <%= link_to new_group_event_path(@group), class: "btn btn-primary" do %>
        <%= icon :new, class: "size-4" %>New event
      <% end %>
    <% end %>

    <%# The invite route arrives with #208, so the call to action is text until it exists: a link
        that lands nowhere is worse than a sentence that asks for one. %>
    <% if @group.current_members.one? %>
      <p class="mt-4 rounded-box bg-base-200 p-4 text-meta">It&rsquo;s just you in here so far. Invite the others</p>
    <% end %>
  </div>
<% end %>
