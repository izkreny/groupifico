<% content_for :title, "Edit group" %>

<%= render "shared/page_header", title: "Group" %>

<div class="w-full">
  <h1 class="text-record"><%= @group.name %></h1>

  <%= render "form", group: @group %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Show this group", group_path(@group), class: "btn btn-ghost" %>
    <%= link_to "Back to groups", groups_path, class: "btn btn-ghost" %>
  </div>
</div>
