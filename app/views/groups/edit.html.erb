<% content_for :title, "Edit group" %>

<%= render "shared/page_header", title: "Group" %>

<div class="w-full">
  <%# `name_in_database` for the reason the layout gives: a refused rename leaves the typed name
      assigned, and this heading is the screen's own record title. %>
  <h1 class="text-record"><%= @group.name_in_database %></h1>

  <%= render "form", group: @group %>

  <%# Alone at the bottom, below the form rather than inside it: the sheet's trigger is a
      `button_to`, and a form cannot hold another. `destroy?` rather than the `edit?` that admitted
      the reader here, which is the whole distinction for a paused owner - allowed the form,
      refused every write on it. %>
  <% if allowed_to?(:destroy?, @group) %>
    <div class="mt-10">
      <%= render "shared/confirm_sheet",
            id: dom_id(@group, :confirm_delete),
            url: group_path(@group),
            label: "Delete group",
            title: "Delete this group?",
            body: "Every member, event and registration goes with it. This can't be undone.",
            dismiss: "Keep group" %>
    </div>
  <% end %>
</div>
