<%# locals: (group:, join_link:, namespace: nil) %>
<%# `namespace` is the styleguide's, as on `groups/form`, since it draws this once per theme; every screen leaves it out and keeps its ids. `join_link` arrives apart from `group` for the styleguide too, which draws a sample link rather than make one. %>
<% id = ->(name) { [ namespace, "join_link", name ].compact.join("_") } %>
<%# WHY: each state's primary control carries `autofocus`, so `showModal` focuses it when the dialog opens and Turbo focuses it after every frame swap, which otherwise drops focus to the page with the control that had it. The styleguide's copies leave it off, since autofocus on a page that draws them inline scrolls the page to the sample on load. %>
<h3 id="<%= id.(:heading) %>" class="font-semibold">Share join link</h3>

<div class="flex flex-col gap-3 pt-3">
  <% if join_link %>
    <% url = new_join_request_url(token: join_link.token) %>
    <%= tag.div class: "flex flex-col gap-3", data: clipboard_data(url, "link", idle_class: "btn-primary", done_class: "btn-secondary") do %>
      <input id="<%= id.(:url) %>" class="input w-full text-ellipsis text-base-content/70" type="text" autocomplete="off" value="<%= url %>" readonly
             aria-labelledby="<%= id.(:heading) %>" aria-describedby="<%= id.(:hint) %>">

      <%= tag.button type: "button", class: "btn btn-primary w-full", autofocus: namespace.nil?, data: { clipboard_target: "button", action: "clipboard#copy" } do %>
        <span class="contents" data-clipboard-target="idle"><%= icon :copy, class: "size-icon-control" %>Copy link</span>
        <span class="contents" hidden data-clipboard-target="done"><%= icon :copied, class: "size-icon-control" %>Link copied</span>
      <% end %>

      <%= clipboard_status %>
    <% end %>

    <div class="flex flex-wrap gap-2">
      <%= render "groups/join_link_confirm", id: id.(:regenerate), url: group_join_link_path(group), method: :post, glyph: :regenerate, trigger: "Regenerate link", confirm: "Regenerate",
            title: "Regenerate join link?", body: "The current link stops working straight away. Anyone who has it but has not asked to join yet will need the new one." %>
      <%= render "groups/join_link_confirm", id: id.(:delete), url: group_join_link_path(group), method: :delete, glyph: :delete, trigger: "Delete link", confirm: "Delete link", classes: "text-error",
            title: "Delete join link?", body: "The link stops working straight away. Anyone who has it but has not asked to join yet will not be able to. You can create a new link later." %>
    </div>
  <% else %>
    <%= button_to safe_join([ icon(:invite_link, class: "size-icon-control"), "Create new join link" ]), group_join_link_path(group), class: "btn btn-primary w-full", form_class: "w-full", autofocus: namespace.nil? %>
  <% end %>

  <p id="<%= id.(:hint) %>" class="text-meta">Whoever opens it signs in through a link mailed to them, fills in their profile, and joins with one click on the group's join page.</p>
</div>
