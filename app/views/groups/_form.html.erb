<%= form_with(model: group, class: "contents") do |form| %>
  <%= form.with_error_summary do %>
    <fieldset class="fieldset">
      <legend class="fieldset-legend">Group details</legend>

      <%= form.field :name %>
      <%= form.field :description, as: :text_area %>

      <%= form.fields_for :address do |address_form| %>
        <%= render "addresses/form_fields", form: address_form %>
      <% end %>
    </fieldset>
  <% end %>

  <div class="inline">
    <%= form.submit class: "btn btn-primary" %>
  </div>
<% end %>
