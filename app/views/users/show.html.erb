<% content_for :title, "Showing user" %>

<div class="md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Showing user</h1>

  <%= render @user %>

  <div class="flex flex-wrap gap-2">
    <%= link_to "Edit this user", edit_user_path, class: "btn btn-ghost" %>
    <%= render "shared/confirm_sheet",
          id: dom_id(@user, :confirm_delete),
          url: user_path,
          label: "Delete my account",
          title: "Delete your account?",
          body: "You leave every group, and every registration you made goes with you. This can't be undone.",
          dismiss: "Keep my account" %>
  </div>
</div>
