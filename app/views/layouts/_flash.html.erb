<% if notice.present? %>
  <%= render layout: "shared/alert", locals: { kind: :success, id: "notice", dismissible: true, classes: "mb-5" } do %>
    <span><%= notice %></span>
  <% end %>
<% end %>

<% if alert.present? %>
  <%= render layout: "shared/alert", locals: { kind: :error, id: "alert", dismissible: true, classes: "mb-5" } do %>
    <span><%= alert %></span>
  <% end %>
<% end %>
