<%# locals: (memberships: nil, **header) %>
<%# The controller is attached only where there is a switcher for it to hold. Bare, it
    connects on every screen with no dialog to find, and `Context#connect` catches the
    missing-target error into `application.handleError` - so nothing breaks visibly and most
    page loads write a JavaScript error to the console, burying any real one. %>
<%= tag.div data: (header[:switcher_id] ? { controller: "group-switcher" } : {}) do %>
  <%= render "layouts/header", **header %>

  <% if header[:switcher_id] %>
    <%= render "layouts/group_switcher", id: header[:switcher_id], memberships: memberships, current_group: header[:group] %>
  <% end %>
<% end %>
