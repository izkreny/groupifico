<%# locals: (memberships:, current_group:) %>
<%#
  The header dropdown's menu, one line per group, which is what `menu` draws: its row is a grid with `grid-auto-flow: column`, so a second span becomes a second column rather than a second line. The badges are the only thing beside the name.

  Rows carry no `dom_id`: `spec/requests/groups_spec.rb` asserts the absence of `group_<id>` in the markup elsewhere.
%>
<ul class="dropdown-content menu bg-base-100 rounded-box border border-base-300 z-10 mt-2 w-64 p-2 shadow-sm">
  <% memberships.each do |membership| %>
    <li>
      <%= link_to group_path(membership.group),
            class: { "menu-active" => membership.group == current_group },
            aria: { current: ("true" if membership.group == current_group) } do %>
        <span class="font-heading text-row-title"><%= membership.group.name %></span>
        <% if membership.owner? %>
          <span class="badge badge-sm">owner</span>
        <% end %>
        <% if membership.paused? %>
          <span class="badge badge-ghost badge-sm">paused</span>
        <% end %>
      <% end %>
    </li>
  <% end %>
</ul>
