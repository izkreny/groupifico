<%# locals: (brand_name:, group: nil, group_name: nil, title: nil, initials: nil, editable: false, switcher_id: nil, memberships: nil, back_path: nil, tabs: false, section: nil) %>
<%# The leading 20px slot is present whether it holds the group mark or a back chevron: that is
    what makes every title start at the same x, and `shared/_page_header` reproduces it empty. %>
<header class="navbar bg-base-100 border-b border-base-content/5 min-h-0 gap-2.5 px-4 py-3">
  <span class="flex-none grid w-5 h-5 place-items-center">
    <% if back_path %>
      <%# WHY: a 32px box, the size of every other icon control, centred on the 20px slot by `-m-1.5`, so the chevron is tapped as easily as they are and stays where the group mark stands. %>
      <%= link_to back_path, class: "grid size-8 -m-1.5 place-items-center text-primary", aria: { label: "Back" } do %>
        <%= icon :back, class: "size-5" %>
      <% end %>
    <% elsif group %>
      <span class="status status-primary" aria-hidden="true"></span>
    <% end %>
  </span>

  <%# A pushed screen's title takes the group name's place, and with it go the switcher and the pencil, which both belong to the name. %>
  <% if title %>
    <h1 class="font-heading text-shell sm:text-hero truncate min-w-0"><%= title %></h1>
  <%# With a second group the name and its chevron are the switcher, looking as a plain name and a ghost chevron button do, and opening a menu of the reader's groups, each a link, so nothing moves until one is pressed. The two chevrons swap on `[open]` alone. %>
  <% elsif switcher_id %>
    <details id="<%= switcher_id %>" class="dropdown group min-w-0" data-controller="dropdown" data-action="click@document->dropdown#close keydown@document->dropdown#close">
      <summary class="flex items-center gap-0.5 min-w-0 cursor-pointer list-none rounded-field focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-primary">
        <h1 class="font-heading text-shell sm:text-hero truncate min-w-0"><%= group_name %></h1>
        <span class="btn btn-ghost btn-circle btn-sm text-primary flex-none">
          <%= icon :disclose, class: "size-5 group-open:hidden" %>
          <%= icon :close_panel, class: "size-5 hidden group-open:block" %>
        </span>
      </summary>

      <%= render "layouts/group_switcher", memberships:, current_group: group %>
    </details>
  <% else %>
    <h1 class="font-heading text-shell sm:text-hero truncate min-w-0"><%= group ? group_name : brand_name %></h1>
  <% end %>

  <% if editable && !title %>
    <%# WHY: the navbar's `gap-2.5` spaces the whole row, so the pencil pulls back from it: its glyph lands 16px from the chevron's, or 8px from the name where no switcher stands between them, as the chevron does. %>
    <%= link_to edit_group_path(group), class: [ "btn btn-ghost btn-circle btn-sm text-primary flex-none", switcher_id ? "-ml-1.5" : "-ml-2" ], aria: { label: "Edit group" } do %>
      <%= icon :edit, class: "size-5" %>
    <% end %>
  <% end %>

  <%# The slack sits here rather than on the name, so the switcher and the pencil stay
      against the name they belong to and only the avatar and the tabs are pushed right. %>
  <span class="grow"></span>

  <span class="flex-none flex items-center gap-4">
    <%# `max-sm:hidden` against the layout's dock `sm:hidden`: one partial, and exactly one
        placement visible at any width. %>
    <% if tabs %>
      <span class="max-sm:hidden flex gap-4">
        <%= render "layouts/group_tabs", group: group, section: section %>
      </span>
    <% end %>

    <% if initials %>
      <%# A `div` rather than a `span`, because `.avatar > div` and `.avatar-placeholder > div`
          are how daisyUI names the box: the first gives it `aspect-ratio: 1/1` and the second
          centres what is inside it, and neither selector matches anything else. %>
      <%= link_to user_profile_path, class: "avatar avatar-placeholder", aria: { label: "#{initials}, me" } do %>
        <div class="bg-base-300 text-base-content w-8 rounded-full">
          <span class="text-card-fact"><%= initials %></span>
        </div>
      <% end %>
    <% end %>
  </span>
</header>
