<%# locals: (group:, section:, in_dock: false) %>
<%#
  The three tabs, rendered twice from one partial: as the dock's children below 640px and inside the
  header above it. `in_dock` is what tells them apart, because `dock-active` draws the dock's own
  indicator bar and has nothing to mark in the header, where the colour carries it alone.

  Icon-only, so each link states its own name: `aria-label` is the whole of what a screen reader
  gets here, and axe is the gate that says so.
%>
<% [
     [ :home,    "Home",    group_path(group)         ],
     [ :events,  "Events",  group_events_path(group)  ],
     [ :members, "Members", group_members_path(group) ]
   ].each do |name, label, path| %>
  <% current = name == section %>
  <%= link_to path,
        class: [ "text-primary" => current, "text-base-content/60" => !current, "dock-active" => (current && in_dock) ],
        aria: { label: label, current: ("page" if current) } do %>
    <svg class="w-5 h-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
      <% case name %>
      <% when :home %>
        <path d="m2.25 12 8.954-8.955c.44-.439 1.152-.439 1.591 0L21.75 12M4.5 9.75v10.125c0 .621.504 1.125 1.125 1.125H9.75v-4.875c0-.621.504-1.125 1.125-1.125h2.25c.621 0 1.125.504 1.125 1.125V21h4.125c.621 0 1.125-.504 1.125-1.125V9.75" />
      <% when :events %>
        <path d="M6.75 3v2.25M17.25 3v2.25M3 18.75V7.5a2.25 2.25 0 0 1 2.25-2.25h13.5A2.25 2.25 0 0 1 21 7.5v11.25m-18 0A2.25 2.25 0 0 0 5.25 21h13.5A2.25 2.25 0 0 0 21 18.75m-18 0v-7.5A2.25 2.25 0 0 1 5.25 9h13.5A2.25 2.25 0 0 1 21 11.25v7.5" />
      <% when :members %>
        <path d="M15 19.128a9.38 9.38 0 0 0 2.625.372 9.337 9.337 0 0 0 4.121-.952 4.125 4.125 0 0 0-7.533-2.493M15 19.128v-.003c0-1.113-.285-2.16-.786-3.07M15 19.128v.106A12.318 12.318 0 0 1 8.624 21c-2.331 0-4.512-.645-6.374-1.766l-.001-.109a6.375 6.375 0 0 1 11.964-3.07M12 6.375a3.375 3.375 0 1 1-6.75 0 3.375 3.375 0 0 1 6.75 0Zm8.25 2.25a2.625 2.625 0 1 1-5.25 0 2.625 2.625 0 0 1 5.25 0Z" />
      <% end %>
    </svg>
  <% end %>
<% end %>
