<!DOCTYPE html>
<html lang="<%= I18n.locale %>">
  <head>
    <%= render "layouts/head" %>
    <%# WHY: an answer, an invitation or a take-off redirects back to the page it was pressed on, which Turbo takes as a refresh, so the page morphs in place, keeping its scroll, rather than redrawing from the top. %>
    <%= turbo_refresh_method_tag :morph %>
    <%= turbo_refresh_scroll_tag :preserve %>
  </head>

  <%# `@group` rather than `Current.group`, which `GroupScoped` assigns from `params[:group_id]`
      and so is nil on every screen `GroupsController` serves - `groups#show` and `groups#edit`
      among them, the two this header exists for. `persisted?` rather than `present?` because
      `groups#new` and a failed `create` both carry an unsaved `Group.new` holding whatever was
      typed. %>
  <% group = @group if @group&.persisted? %>
  <%# `name_in_database`, not `name`: a failed `update` re-renders `edit` on the persisted record
      with the rejected attributes still assigned, so `name` there is whatever was typed - blank
      included - and the header would rename the group the save just refused to rename, while the
      switcher beside it loads its own row and keeps the stored name. %>
  <% group_name = group.name_in_database if group %>
  <% memberships = Current.user.current_memberships.preloaded.to_a if group %>
  <% switcher_id = "group-switcher" if memberships&.many? %>
  <% tabs = shell_tabs?(group) %>

  <body>
    <div class="w-full max-w-[40rem] mx-auto min-h-dvh flex flex-col <%= "max-sm:pb-20" if tabs %>">
      <%= render "layouts/header",
            memberships: memberships,
            brand_name: Current.brand.name,
            group: group,
            group_name: group_name,
            title: content_for(:page_title),
            initials: (Current.user.profile.initials if authenticated?),
            editable: (group.present? && allowed_to?(:edit?, group)),
            switcher_id: switcher_id,
            back_path: ((content_for(:back_path) || section_root_path(group)) if pushed_screen?(group)),
            tabs: tabs,
            section: shell_section %>

      <div class="px-4 pt-3"><%= render "layouts/flash" %></div>

      <main class="px-4 py-3 grow" data-controller="hold-scroll" data-action="turbo:submit-start@document->hold-scroll#hold turbo:morph@document->hold-scroll#restore">
        <%= yield %>
      </main>
    </div>

    <%# The column's `max-sm:pb-20` above is what keeps `layouts/dock` off the content; change either and change both. %>
    <% if tabs %>
      <%= render "layouts/dock", group: group, section: shell_section %>
    <% end %>
  </body>
</html>
