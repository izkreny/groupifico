<% content_for :title, "Create a group" %>

<div class="flex flex-col gap-5">
  <h1 class="text-record">Create a group</h1>

  <%= form_with model: @sign_up, url: sign_up_url, class: "contents" do |form| %>
    <%= form.with_error_summary do %>
      <%# No `fieldset-legend`. It read "Your group", which was true while the fieldset held only
          the group's name; with the address first it would label the email as part of the group,
          and frame 9b draws no legend at all. %>
      <fieldset class="fieldset">
        <%= form.field :email, as: :email_field, label: "Your email", required: true, autofocus: true,
              autocomplete: "username", placeholder: "you@example.com" %>
        <%= form.field :group_name, label: "Group name", required: true,
              placeholder: "Riverside Choir",
              hint: "You become its owner. Rename it later on Edit group." %>
      </fieldset>
    <% end %>

    <div class="inline">
      <%= form.submit "Send my confirmation link", class: "btn btn-primary" %>
    </div>
  <% end %>
</div>
