<% content_for :title, "Create your group" %>

<div class="flex flex-col gap-5">
  <%# "group" rather than the group's type. Frame 10b reads "create your choir Riverside Choir",
      but `SignUp` carries no type until #137 puts the hostname's own on it. %>
  <h1 class="text-record break-words">Sign in as <%= @sign_up.email %> and create your group <%= @sign_up.group_name %></h1>

  <div class="inline">
    <%= button_to "Sign in and create group", sign_up_confirmation_path, class: "btn btn-primary" %>
  </div>

  <%# `sign_ins/show` carries why this is copy rather than a link. %>
  <p class="text-meta">Not you? Just close this page</p>
</div>
