<% content_for :title, "Create your group" %>

<div class="grow flex flex-col gap-5">
  <%# "group" rather than the group's type. Frame 10b reads "create your choir Riverside Choir",
      but `SignUp` carries no type until #137 puts the hostname's own on it. %>
  <h1 class="text-record text-center break-words">Sign in as <span class="block text-secondary"><%= @sign_up.email %></span> and create your group <span class="block text-secondary"><%= @sign_up.group_name %></span></h1>

  <%= button_to sign_up_confirmation_path, class: "btn btn-primary btn-block" do %>
    <%= icon :confirm, class: "size-icon-control" %> Sign in and create group
  <% end %>

  <%# `sign_ins/show` carries why this is copy rather than a link. %>
  <p class="text-meta text-center">Not you? Just close this page</p>

  <p class="text-meta text-center mt-auto">One step: your account, the group and your owner seat, then you are signed in.</p>
</div>
