<% content_for :title, "Sign in" %>

<%# `display: contents` on the form, so its fieldset and its submit are flex items of the stack
    below and take its gap - the same reason every other form in this application carries it. %>
<div class="flex flex-col gap-5">
  <h1 class="text-record">Sign in</h1>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <%# Not `AppFormBuilder#field`: this form has no model, so the builder's `object.errors` read
        has nothing to read. The label and the control carry the classes that helper would emit. %>
    <fieldset class="fieldset">
      <%= form.label :email, "Email", class: "label" %>
      <%# `value: params[:email]` is #208's invitation link, which opens this form with the address
          already in it. A redirect carries no params, so every flashed state renders it empty. %>
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username",
            placeholder: "you@example.com", value: params[:email], class: "input w-full" %>
    </fieldset>

    <div class="inline">
      <%= form.submit "Email me a sign-in link", class: "btn btn-primary" %>
    </div>
  <% end %>

  <%# `text-meta`, never daisyUI's `label`. That component is `display: flex` with
      `white-space: nowrap`, which is right for a word beside a control and wrong for a sentence:
      measured at 390px, this line overflowed the viewport by 79px carrying it. Only the browser
      knows - the element's own box stays inside the column while its text runs past the edge, so
      `getBoundingClientRect` reports nothing wrong. %>
  <p class="text-meta">No passwords. The link in the mail signs you in on this device.</p>
</div>
