<div class="mx-auto md:w-2/3 w-full">
  <h1 class="font-bold text-4xl">Sign in</h1>

  <p class="my-5">Give us your email address and we will send you a link that signs you in.</p>

  <%= form_with url: session_url, class: "contents" do |form| %>
    <div class="my-5">
      <%= form.email_field :email, required: true, autofocus: true, autocomplete: "username", placeholder: "Enter your email address", value: params[:email], class: "input w-full" %>
    </div>

    <div class="inline">
      <%= form.submit "Email me a sign-in link", class: "btn btn-primary" %>
    </div>
  <% end %>

  <p class="my-5">No account yet? <%= link_to "Start a group", new_sign_up_path, class: "link" %>.</p>
</div>
